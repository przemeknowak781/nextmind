# Konfiguracja dla hostingu Apache (home.pl). GitHub Pages ten plik ignoruje.

# Astro generuje 404.html, ale Apache sam z siebie o nim nie wie — bez tej
# linii nieistniejący adres pokazuje domyślną stronę błędu hostingu.
ErrorDocument 404 /404.html

# Pliki w /_astro/ mają skrót treści w nazwie, więc nigdy nie zmieniają się
# „w miejscu" — można je cache'ować na długo. Reszta krótko, żeby zmiany na
# stronie były widoczne od razu po wysyłce.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  <FilesMatch "\.(js|css|woff2)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
