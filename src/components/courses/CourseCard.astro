---
import { formatPrice } from '../../lib/format';

interface Props {
  slug: string;
  title: string;
  eyebrow: string;
  summary: string;
  durationLabel: string;
  level: 'podstawowy' | 'sredniozaawansowany' | 'zaawansowany';
  levelLabel: string;
  priceNet: number;
  priceWithKfs?: number;
  nextEditionLabel?: string;
  keyTools: string[];
  upcoming?: boolean;
  index?: number;
}

const {
  slug,
  title,
  eyebrow,
  summary,
  durationLabel,
  level,
  levelLabel,
  priceNet,
  priceWithKfs,
  nextEditionLabel,
  keyTools,
  upcoming = false,
  index = 0,
} = Astro.props;

const levelDots = level === 'podstawowy' ? 1 : level === 'sredniozaawansowany' ? 2 : 3;

// Compact display: take first segment before colon, fall back to whole title
const cardTitle = title.split(':')[0].trim();
// Compact eyebrow: just first segment (e.g. "Szkolenie 1-dniowe")
const cardEyebrow = eyebrow.split('•')[0].trim();
---

<a href={upcoming ? '#' : `/szkolenia/${slug}/`} class="course-card group" aria-disabled={upcoming}>
  <div class="course-card-inner">
    <div class="flex items-center justify-between gap-3 mb-5">
      <span class="section-counter">{String(index + 1).padStart(2, '0')} / 03</span>
      <span class="flex items-center gap-1.5" title={levelLabel}>
        {[1, 2, 3].map((d) => (
          <span class={`w-1.5 h-1.5 rounded-full ${d <= levelDots ? 'bg-[var(--color-accent)]' : 'bg-[var(--color-rule-strong)]'}`}></span>
        ))}
        <span class="text-[0.65rem] uppercase tracking-[0.14em] text-[var(--color-ink-4)] ml-1 font-mono">{levelLabel}</span>
      </span>
    </div>

    <div class="eyebrow !text-[var(--color-accent)]">{cardEyebrow}</div>

    <h3 class="course-title">{cardTitle}.</h3>

    <p class="course-summary">
      {summary}
    </p>

    <div class="flex flex-wrap gap-1.5 mb-5">
      {keyTools.slice(0, 3).map((tool) => (
        <span class="tag !text-[0.7rem] !py-0.5 !px-2">{tool}</span>
      ))}
      {keyTools.length > 3 && <span class="tag !text-[0.7rem] !py-0.5 !px-2">+{keyTools.length - 3}</span>}
    </div>

    <div class="rule-dotted my-4"></div>

    <dl class="grid grid-cols-2 gap-x-3 gap-y-3 text-[0.78rem]">
      <div>
        <dt class="card-meta-label">Czas</dt>
        <dd class="card-meta-value">{durationLabel}</dd>
      </div>
      <div>
        <dt class="card-meta-label">Następna edycja</dt>
        <dd class="card-meta-value">{upcoming ? 'Q3 2026' : nextEditionLabel ?? '—'}</dd>
      </div>
      <div>
        <dt class="card-meta-label">Cena netto</dt>
        <dd class="card-meta-value tabular-nums">
          {upcoming ? '—' : formatPrice(priceNet)}
        </dd>
      </div>
      <div>
        <dt class="card-meta-label">Z dofinans. KFS</dt>
        <dd class="card-meta-kfs">
          {upcoming ? 'lista chętnych' : (priceWithKfs ? formatPrice(priceWithKfs) : '—')}
        </dd>
      </div>
    </dl>

    <div class="course-card-cta">
      <span>{upcoming ? 'Zostaw kontakt' : 'Zobacz program'}</span>
      <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 16 16" fill="none">
        <path d="M3 8H13M13 8L8 3M13 8L8 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </div>
  </div>
</a>

<style>
  .course-card {
    display: block;
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.35s cubic-bezier(0.2, 0.7, 0.1, 1);
    height: 100%;
  }
  .course-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 24px 50px -24px rgba(45, 91, 255, 0.18);
  }
  .course-card-inner {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
  @media (min-width: 768px) {
    .course-card-inner { padding: 1.75rem; }
  }
  .course-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.03em;
    margin-top: 0.65rem;
    margin-bottom: 0.85rem;
    color: var(--color-ink);
  }
  @media (min-width: 1024px) {
    .course-title { font-size: 1.5rem; }
  }
  .course-summary {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }
  .card-meta-label {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-4);
    margin-bottom: 0.25rem;
  }
  .card-meta-value {
    color: var(--color-ink);
    font-weight: 500;
    font-size: 0.875rem;
  }
  .card-meta-kfs {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-accent);
    font-feature-settings: 'tnum';
    letter-spacing: -0.03em;
  }
  .course-card-cta {
    margin-top: auto;
    padding-top: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--color-ink);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: -0.005em;
  }
</style>
