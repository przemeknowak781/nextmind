---
// Cookie consent — minimalist editorial style. Opt-in.
---

<div
  id="cookie-banner"
  hidden
  class="fixed bottom-0 inset-x-0 z-[60] p-4 md:p-6"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
>
  <div class="container-edge">
    <div class="card card-raised rounded-lg p-5 md:p-6 max-w-2xl mx-auto md:ml-auto md:mr-0">
      <div class="flex items-start gap-4">
        <div class="hidden md:flex shrink-0 w-10 h-10 rounded-full bg-[var(--color-paper-soft)] items-center justify-center">
          <svg class="w-5 h-5 text-[var(--color-ink-3)]" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.3" />
            <circle cx="7" cy="9" r="0.8" fill="currentColor" />
            <circle cx="11.5" cy="7" r="0.8" fill="currentColor" />
            <circle cx="13" cy="11.5" r="0.8" fill="currentColor" />
            <circle cx="8.5" cy="13" r="0.8" fill="currentColor" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h2 id="cookie-title" class="font-display italic text-2xl text-[var(--color-ink)] leading-tight">
            O ciasteczkach.
          </h2>
          <p id="cookie-desc" class="mt-2 text-sm text-[var(--color-ink-3)] leading-relaxed">
            Do statystyk odwiedzin możemy użyć Plausible — narzędzia, które nie zapisuje ciasteczek,
            nie tworzy profili i nie śledzi Cię między stronami. Wczytamy je tylko za Twoją zgodą.
            Szczegóły w <a href="/polityka-cookies/" class="ink-link">polityce cookies</a>.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" data-cookie-accept class="btn btn-primary btn-sm">
              Akceptuję wszystkie
            </button>
            <button type="button" data-cookie-essential class="btn btn-ghost btn-sm">
              Tylko niezbędne
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Zgoda steruje faktycznym wczytaniem analityki. Wcześniej oba przyciski
  // zapisywały tylko wartość w localStorage, której nic nie odczytywało,
  // a skrypt Plausible i tak ładował się na każdej podstronie.
  const KEY = 'nma-cookie-consent';
  const PLAUSIBLE_SRC = 'https://plausible.io/js/script.js';
  const PLAUSIBLE_DOMAIN = 'next-mind.pl';

  function loadAnalytics() {
    if (document.querySelector(`script[src="${PLAUSIBLE_SRC}"]`)) return;
    const s = document.createElement('script');
    s.defer = true;
    s.src = PLAUSIBLE_SRC;
    s.setAttribute('data-domain', PLAUSIBLE_DOMAIN);
    document.head.appendChild(s);
  }

  const banner = document.getElementById('cookie-banner');
  const stored = localStorage.getItem(KEY);

  if (stored === 'all') loadAnalytics();

  if (banner) {
    if (!stored) requestAnimationFrame(() => banner.removeAttribute('hidden'));

    const close = (mode: string) => {
      localStorage.setItem(KEY, mode);
      banner.setAttribute('hidden', '');
      if (mode === 'all') loadAnalytics();
    };

    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => close('all'));
    banner.querySelector('[data-cookie-essential]')?.addEventListener('click', () => close('essential'));
  }

  // Wycofanie zgody musi być równie łatwe jak jej udzielenie (art. 7 ust. 3 RODO).
  // Link z polityki cookies: <a href="#" data-cookie-reset>
  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement | null)?.closest?.('[data-cookie-reset]');
    if (!t) return;
    e.preventDefault();
    localStorage.removeItem(KEY);
    location.reload();
  });
</script>
