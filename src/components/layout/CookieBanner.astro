---
// Cookie consent — minimalist editorial style. Opt-in.
---

<div
  id="cookie-banner"
  hidden
  class="fixed bottom-0 inset-x-0 z-[60] p-4 md:p-6"
  role="dialog"
  aria-labelledby="cookie-title"
  aria-describedby="cookie-desc"
>
  <div class="container-edge">
    <div class="card card-raised rounded-lg p-5 md:p-6 max-w-2xl mx-auto md:ml-auto md:mr-0">
      <div class="flex items-start gap-4">
        <div class="hidden md:flex shrink-0 w-10 h-10 rounded-full bg-[var(--color-paper-soft)] items-center justify-center">
          <svg class="w-5 h-5 text-[var(--color-ink-3)]" viewBox="0 0 20 20" fill="none">
            <circle cx="10" cy="10" r="7.5" stroke="currentColor" stroke-width="1.3" />
            <circle cx="7" cy="9" r="0.8" fill="currentColor" />
            <circle cx="11.5" cy="7" r="0.8" fill="currentColor" />
            <circle cx="13" cy="11.5" r="0.8" fill="currentColor" />
            <circle cx="8.5" cy="13" r="0.8" fill="currentColor" />
          </svg>
        </div>
        <div class="flex-1 min-w-0">
          <h2 id="cookie-title" class="font-display italic text-2xl text-[var(--color-ink)] leading-tight">
            O ciasteczkach.
          </h2>
          <p id="cookie-desc" class="mt-2 text-sm text-[var(--color-ink-3)] leading-relaxed">
            Używamy Plausible — analityki bez cookies i bez śledzenia. Wybierz, czy chcesz dodatkowe analityki.
            Szczegóły w <a href="/polityka-cookies/" class="ink-link">polityce cookies</a>.
          </p>
          <div class="mt-4 flex flex-wrap gap-2">
            <button type="button" data-cookie-accept class="btn btn-primary btn-sm">
              Akceptuję wszystkie
            </button>
            <button type="button" data-cookie-essential class="btn btn-ghost btn-sm">
              Tylko niezbędne
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const KEY = 'nma-cookie-consent';
  const banner = document.getElementById('cookie-banner');
  if (banner) {
    const stored = localStorage.getItem(KEY);
    if (!stored) {
      requestAnimationFrame(() => banner.removeAttribute('hidden'));
    }
    const acceptAll = banner.querySelector('[data-cookie-accept]');
    const essential = banner.querySelector('[data-cookie-essential]');
    const close = (mode: string) => {
      localStorage.setItem(KEY, mode);
      banner.setAttribute('hidden', '');
    };
    acceptAll?.addEventListener('click', () => close('all'));
    essential?.addEventListener('click', () => close('essential'));
  }
</script>
