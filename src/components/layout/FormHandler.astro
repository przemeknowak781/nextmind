---
// Lightweight form-handling script — applied to all forms with [data-form] attribute.
// In MVP without a backend: prevents default submit, validates fields, redirects to thank-you.
// When backend (Resend / Cloudflare Workers) is ready — replace the redirect with a fetch().
---

<script>
  const REDIRECT_MAP: Record<string, string> = {
    newsletter: '/thank-you/zapis-newsletter/',
    'lead-magnet': '/thank-you/zapis-newsletter/',
    'program-100h': '/thank-you/zapis-newsletter/',
    kontakt: '/thank-you/zapis-newsletter/',
    firma: '/thank-you/zapytanie-firma/',
  };

  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const formType = form.dataset.form ?? 'kontakt';

    form.addEventListener('submit', (e) => {
      // Native HTML5 validation first
      if (!form.checkValidity()) return;

      e.preventDefault();

      // Visual loading state
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.dataset.originalText = submitBtn.textContent ?? '';
        submitBtn.textContent = 'Wysyłam…';
      }

      // Plausible event
      if (typeof window !== 'undefined' && (window as any).plausible) {
        (window as any).plausible(`form_${formType}_submit`);
      }

      // Simulate request — in prod, replace with fetch to /api/*
      setTimeout(() => {
        const target = REDIRECT_MAP[formType] ?? '/thank-you/zapis-newsletter/';
        window.location.href = target;
      }, 600);
    });
  });
</script>
