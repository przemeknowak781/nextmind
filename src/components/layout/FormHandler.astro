---
import { SITE, FORM_ENDPOINT } from '../../lib/site';

// Obsługa wszystkich formularzy oznaczonych [data-form].
//
// DLACZEGO TO ZOSTAŁO PRZEPISANE
// Poprzednia wersja wyłącznie UDAWAŁA wysyłkę: przechwytywała submit, czekała
// 600 ms i przekierowywała na stronę „dziękujemy". Żadne dane nie były nigdzie
// wysyłane ani zapisywane, a użytkownik widział potwierdzenie sukcesu, który
// nie nastąpił. Dotyczyło to wszystkich formularzy, łącznie z kontaktowym.
//
// JAK DZIAŁA TERAZ
// 1. Jeżeli w src/lib/site.ts ustawiono FORM_ENDPOINT — wysyłamy tam POST-a
//    i dopiero po odpowiedzi 2xx przechodzimy na stronę potwierdzenia.
//    Błąd sieci lub odpowiedź inna niż 2xx pokazuje komunikat, a nie sukces.
// 2. Jeżeli FORM_ENDPOINT jest pusty — otwieramy wiadomość w programie
//    pocztowym użytkownika z wypełnioną treścią. Użytkownik widzi, co wysyła,
//    i sam decyduje o wysłaniu. Nie pokazujemy wtedy ekranu „dziękujemy",
//    bo nie mamy potwierdzenia, że wiadomość wyszła.
---

<script define:vars={{ FORM_ENDPOINT, CONTACT_EMAIL: SITE.email }}>
  const REDIRECT_MAP = {
    newsletter: '/thank-you/zapis-newsletter/',
    'lead-magnet': '/thank-you/zapis-newsletter/',
    'program-100h': '/thank-you/zapis-newsletter/',
    kontakt: '/thank-you/zapis-newsletter/',
    firma: '/thank-you/zapytanie-firma/',
  };

  const SUBJECTS = {
    newsletter: 'Zapis na newsletter',
    'lead-magnet': 'Prośba o materiał',
    'program-100h': 'Zapytanie o Program 100h',
    kontakt: 'Zapytanie ze strony',
    firma: 'Zapytanie firmowe',
  };

  function showMessage(form, text, isError) {
    let box = form.querySelector('[data-form-msg]');
    if (!box) {
      box = document.createElement('p');
      box.setAttribute('data-form-msg', '');
      box.setAttribute('role', 'status');
      box.setAttribute('aria-live', 'polite');
      box.style.cssText = 'margin-top:.75rem;font-size:.875rem;line-height:1.5';
      form.appendChild(box);
    }
    box.style.color = isError ? 'var(--color-danger)' : 'var(--color-ink-3)';
    box.textContent = text;
  }

  function restore(btn) {
    if (!btn) return;
    btn.disabled = false;
    if (btn.dataset.originalText) btn.textContent = btn.dataset.originalText;
  }

  document.querySelectorAll('form[data-form]').forEach((form) => {
    const submitBtn = form.querySelector('button[type="submit"]');
    const formType = form.dataset.form ?? 'kontakt';

    form.addEventListener('submit', async (e) => {
      if (!form.checkValidity()) return;
      e.preventDefault();

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.dataset.originalText = submitBtn.textContent ?? '';
        submitBtn.textContent = 'Wysyłam…';
      }

      if (typeof window !== 'undefined' && window.plausible) {
        window.plausible(`form_${formType}_submit`);
      }

      const data = new FormData(form);

      // Wariant 1 — skonfigurowany endpoint.
      if (FORM_ENDPOINT) {
        try {
          const res = await fetch(FORM_ENDPOINT, {
            method: 'POST',
            body: data,
            headers: { Accept: 'application/json' },
          });
          if (!res.ok) throw new Error('HTTP ' + res.status);
          window.location.href = REDIRECT_MAP[formType] ?? '/thank-you/zapis-newsletter/';
        } catch (err) {
          restore(submitBtn);
          showMessage(
            form,
            `Nie udało się wysłać formularza. Napisz bezpośrednio na ${CONTACT_EMAIL}.`,
            true
          );
        }
        return;
      }

      // Wariant 2 — brak endpointu: otwieramy wiadomość w kliencie pocztowym.
      const lines = [];
      for (const [k, v] of data.entries()) {
        if (typeof v === 'string' && v.trim() && k !== 'rodo') lines.push(`${k}: ${v}`);
      }
      const subject = SUBJECTS[formType] ?? 'Wiadomość ze strony';
      const href =
        `mailto:${CONTACT_EMAIL}` +
        `?subject=${encodeURIComponent(subject)}` +
        `&body=${encodeURIComponent(lines.join('\n'))}`;

      window.location.href = href;
      restore(submitBtn);
      showMessage(
        form,
        'Otworzyliśmy wiadomość w Twoim programie pocztowym — wyślij ją, żeby dokończyć zgłoszenie.',
        false
      );
    });
  });
</script>
