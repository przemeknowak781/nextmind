---
import { NAV } from '../../lib/site';
import Logo from './Logo.astro';

interface Props {
  hideBorder?: boolean;
}
const { hideBorder = false } = Astro.props;
const path = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<!-- Announcement bar -->
<div class="bg-[var(--color-ink)] text-[var(--color-paper)]">
  <div class="container-edge flex items-center justify-between gap-4 py-2 text-[0.8125rem]">
    <div class="flex items-center gap-3 opacity-90">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-accent-soft)] animate-pulse"></span>
      <span class="hidden sm:inline">Najbliższa edycja Basic — środa, <strong class="font-medium">10 czerwca 2026</strong>. Zostały 4 z 8 miejsc.</span>
      <span class="sm:hidden">Najbliższa edycja: 10.06.2026 — 4 miejsca</span>
    </div>
    <a href="/terminy/" class="text-[var(--color-paper)] underline-offset-4 hover:underline whitespace-nowrap">
      Zobacz kalendarz →
    </a>
  </div>
</div>

<header class={`site-header ${hideBorder ? '' : 'border-b border-[var(--color-rule)]'}`}>
  <div class="container-edge">
    <div class="flex items-center justify-between gap-6 py-4 lg:py-5">
      <a href="/" aria-label="Next Mind Academy — strona główna" class="shrink-0">
        <Logo class="h-10 lg:h-12 w-auto" alt="" />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Nawigacja główna">
        {NAV.primary.map((item) => (
          <div class={`nav-item ${item.children ? 'has-dropdown' : ''}`}>
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? 'is-active' : ''}`}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
              {item.children && (
                <svg class="w-3 h-3 opacity-60" viewBox="0 0 12 12" fill="none">
                  <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              )}
            </a>
            {item.children && (
              <div class="nav-dropdown">
                <div class="nav-dropdown-inner">
                  <span class="eyebrow">{item.label}</span>
                  <ul class="space-y-1">
                    {item.children.map((child) => (
                      <li>
                        <a href={child.href} class="nav-dropdown-item">
                          <span class="nav-dropdown-label">{child.label}</span>
                          {'summary' in child && child.summary && (
                            <span class="nav-dropdown-desc">{child.summary}</span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>

      <div class="flex items-center gap-2 lg:gap-3">
        <a href="/kontakt/" class="hidden md:inline-flex btn btn-secondary btn-sm">
          Kontakt
        </a>
        <a href="/terminy/" class="hidden lg:inline-flex btn btn-primary btn-sm">
          Najbliższe terminy
        </a>

        <!-- Mobile burger -->
        <button
          type="button"
          class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-full border border-[var(--color-rule-strong)] hover:border-[var(--color-ink)] transition-colors"
          aria-label="Otwórz menu"
          aria-expanded="false"
          data-mobile-toggle
        >
          <svg class="w-5 h-5" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-drawer" data-mobile-drawer hidden>
    <div class="container-edge py-6 space-y-6">
      <nav aria-label="Nawigacja mobilna" class="space-y-2">
        {NAV.primary.map((item) => (
          <details class="mobile-nav-group">
            <summary class="mobile-nav-summary">
              <a href={item.href} class="font-medium text-[var(--color-ink)]">
                {item.label}
              </a>
              {item.children && (
                <svg class="w-4 h-4 opacity-50 group-open:rotate-180 transition" viewBox="0 0 16 16" fill="none">
                  <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
                </svg>
              )}
            </summary>
            {item.children && (
              <ul class="pl-4 mt-2 space-y-1.5">
                {item.children.map((c) => (
                  <li>
                    <a href={c.href} class="block py-1.5 text-[var(--color-ink-3)] hover:text-[var(--color-accent)]">
                      {c.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </details>
        ))}
        <div class="pt-2 space-y-1">
          <a href="/o-akademii/" class="block py-2 text-[var(--color-ink-3)]">O akademii</a>
          <a href="/faq/" class="block py-2 text-[var(--color-ink-3)]">FAQ</a>
          <a href="/kontakt/" class="block py-2 text-[var(--color-ink-3)]">Kontakt</a>
        </div>
      </nav>
      <div class="flex flex-col gap-2 pt-4 border-t border-[var(--color-rule)]">
        <a href="/terminy/" class="btn btn-primary">Najbliższe terminy</a>
        <a href="/dofinansowanie/kalkulator/" class="btn btn-ghost">Sprawdź dofinansowanie</a>
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(10px) saturate(120%);
    -webkit-backdrop-filter: blur(10px) saturate(120%);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.9rem;
    font-size: 0.9375rem;
    font-weight: 400;
    color: var(--color-ink-2);
    border-radius: 999px;
    transition: all 0.2s ease;
    position: relative;
    text-decoration: none;
  }

  .nav-link:hover {
    color: var(--color-ink);
    background: var(--color-paper-deep);
  }

  .nav-link.is-active {
    color: var(--color-ink);
    background: var(--color-paper-deep);
  }

  .nav-item.has-dropdown {
    position: relative;
  }

  .nav-dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 0.5rem;
    min-width: 320px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s ease;
    pointer-events: none;
    z-index: 60;
  }

  .nav-item.has-dropdown:hover .nav-dropdown,
  .nav-item.has-dropdown:focus-within .nav-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .nav-dropdown-inner {
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    box-shadow: 0 24px 60px -20px rgba(21, 17, 13, 0.18);
    padding: 1.25rem;
  }

  .nav-dropdown-inner .eyebrow {
    margin-bottom: 1rem;
  }

  .nav-dropdown-item {
    display: block;
    padding: 0.65rem 0.85rem;
    border-radius: 6px;
    text-decoration: none;
    transition: background 0.15s ease;
  }

  .nav-dropdown-item:hover {
    background: var(--color-paper-soft);
  }

  .nav-dropdown-label {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-ink);
  }

  .nav-dropdown-desc {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.8125rem;
    color: var(--color-ink-4);
    line-height: 1.4;
  }

  .mobile-drawer {
    border-top: 1px solid var(--color-rule);
    background: var(--color-paper);
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }
  .mobile-drawer[hidden] { display: none; }

  .mobile-nav-group { border-bottom: 1px solid var(--color-rule-soft); padding-block: 0.5rem; }
  .mobile-nav-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.25rem;
    cursor: pointer;
    list-style: none;
  }
  .mobile-nav-summary::-webkit-details-marker { display: none; }
</style>

<script>
  const toggle = document.querySelector('[data-mobile-toggle]');
  const drawer = document.querySelector('[data-mobile-drawer]');
  if (toggle && drawer) {
    toggle.addEventListener('click', () => {
      const isOpen = !drawer.hasAttribute('hidden');
      if (isOpen) {
        drawer.setAttribute('hidden', '');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Otwórz menu');
      } else {
        drawer.removeAttribute('hidden');
        toggle.setAttribute('aria-expanded', 'true');
        toggle.setAttribute('aria-label', 'Zamknij menu');
      }
    });
  }
</script>
