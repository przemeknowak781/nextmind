---
interface Props {
  class?: string;
  variant?: 'default' | 'inverted';
  alt?: string;
}
const {
  class: className = 'h-12 w-auto',
  variant = 'default',
  alt = 'Next Mind Academy',
} = Astro.props;

// Two pre-rendered variants: the dark-ink original for light surfaces, and a
// white-ink recolour for dark surfaces (the accent blue is kept in both).
// Root-relative paths get the base prefix applied by scripts/rewrite-base.mjs.
const src = variant === 'inverted' ? '/logo-inverted.png' : '/logo.png';
---

<img
  src={src}
  class={className}
  width="556"
  height="264"
  alt={alt}
  loading="eager"
  decoding="async"
/>
