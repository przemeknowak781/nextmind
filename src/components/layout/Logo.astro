---
interface Props {
  class?: string;
  variant?: 'default' | 'inverted';
}
const { class: className = 'h-9 w-auto', variant = 'default' } = Astro.props;

const ink = variant === 'inverted' ? '#ffffff' : '#0a1530';
const accent = '#2d5bff';
---

<svg class={className} viewBox="0 0 220 36" fill="none" aria-hidden="true">
  <!-- Monogram tile — solid blue square with white "n" -->
  <g>
    <rect x="0" y="0" width="36" height="36" rx="8" fill={accent} />
    <text
      x="18"
      y="25"
      text-anchor="middle"
      font-family="'Geist', sans-serif"
      font-size="20"
      font-weight="700"
      fill="#ffffff"
      letter-spacing="-0.04em"
    >n</text>
  </g>

  <!-- Wordmark — bold sans -->
  <g transform="translate(48, 0)">
    <text
      x="0"
      y="16"
      font-family="'Geist', sans-serif"
      font-size="13.5"
      font-weight="600"
      fill={ink}
      letter-spacing="-0.04em"
    >Next Mind</text>
    <text
      x="0"
      y="31"
      font-family="'Geist', sans-serif"
      font-size="13.5"
      font-weight="400"
      fill={ink}
      letter-spacing="-0.03em"
      opacity="0.65"
    >Academy</text>
  </g>
</svg>
