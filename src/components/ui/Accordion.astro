---
// Pure CSS / native <details> accordion — no JS required
interface Item {
  question: string;
  answer: string;
  open?: boolean;
}
interface Props {
  items: Item[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
---

<div class={`divide-y divide-[var(--color-rule)] ${className}`}>
  {items.map((item, i) => (
    <details class="accordion-item group" open={item.open}>
      <summary class="accordion-summary">
        <span class="accordion-no">{String(i + 1).padStart(2, '0')}</span>
        <span class="accordion-q">{item.question}</span>
        <span class="accordion-icon" aria-hidden="true">
          <svg viewBox="0 0 16 16" fill="none" class="w-4 h-4">
            <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </summary>
      <div class="accordion-content">
        <p set:html={item.answer} />
      </div>
    </details>
  ))}
</div>

<style>
  .accordion-item {
    padding-block: 0;
  }
  .accordion-summary {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
    transition: background 0.2s ease;
  }
  .accordion-summary::-webkit-details-marker { display: none; }
  .accordion-summary:hover .accordion-q { color: var(--color-accent); }
  .accordion-no {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink-4);
    font-feature-settings: 'tnum';
  }
  .accordion-q {
    font-family: var(--font-display);
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--color-ink);
    letter-spacing: -0.015em;
    transition: color 0.2s ease;
  }
  @media (min-width: 768px) {
    .accordion-q { font-size: 1.625rem; }
  }
  .accordion-icon {
    color: var(--color-ink-3);
    transition: transform 0.3s ease;
    align-self: center;
  }
  .accordion-item[open] .accordion-icon { transform: rotate(180deg); }
  .accordion-content {
    padding-bottom: 1.75rem;
    padding-left: 3rem;
    color: var(--color-ink-3);
    font-size: 1rem;
    line-height: 1.65;
    max-width: 56rem;
  }
  .accordion-content p {
    margin: 0;
  }
</style>
