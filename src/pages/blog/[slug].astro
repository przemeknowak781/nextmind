---
import { getCollection, render, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { formatDateLong } from '../../lib/format';
import { articleSchema } from '../../lib/schema-org';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { slug: article.data.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const a = article.data;
const { Content } = await render(article);
const trainer = await getEntry('trainers', a.author);

const allArticles = (await getCollection('articles')).filter((art) => art.data.slug !== a.slug);
const related = allArticles.slice(0, 3);

const schema = articleSchema({
  title: a.title,
  description: a.metaDescription,
  url: `/blog/${a.slug}/`,
  publishDate: a.publishDate.toISOString(),
  authorName: trainer?.data.name ?? 'Next Mind Academy',
});
---

<BaseLayout
  title={a.titleSeo}
  description={a.metaDescription}
  ogType="article"
  schemas={[schema]}
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Blog', url: '/blog/' },
      { name: a.title.length > 50 ? a.title.slice(0, 50) + '…' : a.title },
    ]} />
  </div>

  <article>
    <header class="container-edge pt-12 pb-10">
      <div class="max-w-3xl mx-auto">
        <div class="flex items-center gap-3 mb-6">
          <span class="tag tag-accent">{a.categoryLabel}</span>
          <span class="font-mono text-xs text-[var(--color-ink-4)]">
            {formatDateLong(a.publishDate)} · {a.readingTime} min
          </span>
        </div>
        <h1 class="text-4xl md:text-5xl lg:text-[4.25rem] leading-[1.04] tracking-tight">
          {a.title}
        </h1>
        <p class="lead mt-6 text-[var(--color-ink-3)]">{a.excerpt}</p>
        {trainer && (
          <div class="mt-8 flex items-center gap-3 pt-6 border-t border-[var(--color-rule)]">
            <div class="w-10 h-10 rounded-full bg-[var(--color-ink)] flex items-center justify-center font-display italic text-[var(--color-marker)]">
              {trainer.data.name.charAt(0)}
            </div>
            <div>
              <div class="text-sm font-medium text-[var(--color-ink)]">{trainer.data.name}</div>
              <div class="text-xs text-[var(--color-ink-4)]">{trainer.data.title}</div>
            </div>
          </div>
        )}
      </div>
    </header>

    <div class="container-edge pb-16">
      <div class="prose-editorial max-w-3xl mx-auto">
        <Content />
      </div>
    </div>
  </article>

  <Section surface="paper-soft" padding="default">
    <h2 class="text-3xl md:text-4xl tracking-tight leading-tight mb-8 max-w-3xl">
      Czytaj dalej.
    </h2>
    <div class="grid md:grid-cols-3 gap-5">
      {related.map((art) => (
        <a href={`/blog/${art.data.slug}/`} class="article-related">
          <div class="flex items-center gap-2 mb-3">
            <span class="tag">{art.data.categoryLabel}</span>
          </div>
          <h3 class="font-display text-xl tracking-tight leading-tight text-[var(--color-ink)]">{art.data.title}</h3>
          <p class="mt-3 text-sm text-[var(--color-ink-3)] line-clamp-3">{art.data.excerpt}</p>
        </a>
      ))}
    </div>
  </Section>

  <section class="surface-night">
    <div class="container-edge py-20 md:py-28">
      <h2 class="text-4xl md:text-5xl text-[var(--color-paper)] tracking-tight leading-tight max-w-3xl">
        Albo od razu — <span class="display-italic text-[var(--color-marker)]">do praktyki</span>.
      </h2>
      <p class="mt-5 text-lg text-white/70 max-w-xl">
        Najbliższa edycja Basic — 10.06.2026. Online live, kameralna grupa.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/szkolenia/" class="btn btn-accent btn-lg">Zobacz szkolenia</a>
        <a href="/dofinansowanie/kalkulator/" class="btn btn-ghost btn-lg !border-white/20 !text-[var(--color-paper)] hover:!bg-white/10">Sprawdź dofinansowanie</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .article-related {
    display: block;
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    padding: 1.5rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.25s ease;
  }
  .article-related:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
