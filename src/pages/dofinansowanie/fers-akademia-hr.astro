---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
---

<BaseLayout
  title="FERS Akademia HR — dofinansowanie szkoleń AI dla działów HR | 2026"
  description="Program FERS — Akademia HR. Dofinansowanie szkoleń AI i cyfrowych dla działów personalnych w Polsce. Wnioskowanie i pułapy."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Dofinansowanie', url: '/dofinansowanie/' },
      { name: 'FERS — Akademia HR' },
    ]} />
  </div>

  <Section padding="default">
    <div class="eyebrow">Fundusze Europejskie dla Rozwoju Społecznego</div>
    <h1 class="mt-5 text-5xl md:text-6xl lg:text-[5.5rem] leading-[0.96] tracking-tight max-w-5xl">
      FERS — <span class="display-italic">Akademia HR</span>.
    </h1>
    <p class="lead mt-7 text-[var(--color-ink-3)] max-w-3xl">
      Mniej znany, częściej pomijany mechanizm. Dla pracowników działów personalnych i HR.
      Środki centralne, dystrybuowane przez PARP — bez kolejek regionalnych.
    </p>
  </Section>

  <Section surface="paper-soft" padding="default">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-3xl md:text-4xl tracking-tight leading-tight">Dla kogo</h2>
        <ul class="mt-6 space-y-3 text-[var(--color-ink-2)]">
          {[
            'Pracownicy działów HR, kadr i rozwoju w MŚP',
            'Specjaliści ds. szkoleń i rekrutacji',
            'Osoby przygotowujące transformację cyfrową w organizacji',
            'HRBP w średnich firmach',
          ].map((p) => (
            <li class="flex items-start gap-2"><span class="text-[var(--color-accent)] mt-1">—</span><span>{p}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <h2 class="text-3xl md:text-4xl tracking-tight leading-tight">Co finansuje</h2>
        <ul class="mt-6 space-y-3 text-[var(--color-ink-2)]">
          {[
            'Szkolenia z AI dla HR — od bezpieczeństwa po rekrutację',
            'Custom GPT dla zespołów personalnych',
            'Programy 24h+ przygotowane pod profil HR',
            'Walidacja kompetencji DigComp 2.2',
          ].map((p) => (
            <li class="flex items-start gap-2"><span class="text-[var(--color-accent)] mt-1">—</span><span>{p}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <Section padding="default">
    <div class="bg-[var(--color-card-raised)] border border-[var(--color-rule)] rounded-lg p-8 md:p-12">
      <span class="eyebrow !text-[var(--color-accent)]">Pułapy i mechanika</span>
      <h2 class="mt-3 text-3xl md:text-4xl tracking-tight leading-tight">
        80% pokrycia, do 6 000 zł na osobę.
      </h2>
      <p class="mt-5 text-[var(--color-ink-3)] leading-relaxed max-w-3xl">
        Standardowo FERS — Akademia HR pokrywa 80% kosztów szkoleń, do 6 000 zł rocznie na uczestnika.
        Wniosek składa się elektronicznie u PARP. Czas decyzji: 2–4 tygodnie.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/kontakt/" class="btn btn-primary">Pomożemy z wnioskiem</a>
        <a href="https://www.parp.gov.pl" target="_blank" rel="noopener" class="btn btn-ghost">PARP — strona oficjalna →</a>
      </div>
    </div>
  </Section>
</BaseLayout>
