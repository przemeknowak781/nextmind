---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { AUDIENCES, analyze, type Audience, type Headcount } from '../../lib/advisor';
import { REGIONS_SORTED, STATUS_LABELS, PARP_OPERATORS_URL, formatVerified } from '../../lib/regions';
import { getCatalog } from '../../lib/bur';

// Wyniki liczymy w czasie builda — logika zostaje w jednym miejscu (advisor.ts),
// a przeglądarka dostaje gotową mapę odpowiedzi.
const HEADCOUNTS: Headcount[] = ['do-9', 'od-10'];
const results: Record<string, ReturnType<typeof analyze>> = {};

for (const a of AUDIENCES) {
  for (const r of REGIONS_SORTED) {
    if (a.asksHeadcount) {
      for (const h of HEADCOUNTS) {
        results[`${a.value}|${r.slug}|${h}`] = analyze(a.value as Audience, r.slug, h);
      }
    } else {
      results[`${a.value}|${r.slug}|-`] = analyze(a.value as Audience, r.slug);
    }
  }
}

// Presety cen bierzemy z realnego katalogu — trzy różne progi cenowe,
// żeby użytkownik mógł policzyć wkład dla szkolenia zbliżonego do swojego.
const catalogPrices = [
  ...new Set(
    getCatalog()
      .map((o) => o.priceNet)
      .filter((p): p is number => typeof p === 'number')
  ),
].sort((a, b) => a - b);

const PRICES = [
  catalogPrices[0],
  catalogPrices[Math.floor(catalogPrices.length / 2)],
  catalogPrices[catalogPrices.length - 1],
]
  .filter((v, i, arr) => typeof v === 'number' && arr.indexOf(v) === i)
  .map((value) => ({ label: `${Math.round(value)} zł`, value }));
---

<BaseLayout
  title="Analizator dofinansowania — sprawdź, gdzie złożyć wniosek"
  description="Odpowiedz na dwa pytania i zobacz, która instytucja prowadzi Twój wniosek o dofinansowanie szkolenia: powiatowy urząd pracy czy operator regionalny."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Dofinansowanie', url: '/dofinansowanie/' },
      { name: 'Analizator' },
    ]} />
  </div>

  <Section padding="default">
    <div class="max-w-3xl">
      <div class="eyebrow">Analizator</div>
      <h1 class="mt-5 page-h1">
        Gdzie złożyć <span class="display-italic">wniosek</span>?
      </h1>
      <p class="lead mt-6 text-[var(--color-ink-3)]">
        Największy błąd to złożenie wniosku w niewłaściwej instytucji. Odpowiedz na dwa pytania,
        a pokażemy Ci właściwą ścieżkę — wraz z tym, co trzeba przygotować.
      </p>
    </div>
  </Section>

  <Section surface="paper-soft" padding="default">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <!-- FORMULARZ -->
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        <fieldset class="step">
          <legend class="step-legend"><span class="step-num">01</span> Kim jesteś?</legend>
          <div class="opts">
            {AUDIENCES.map((a, i) => (
              <label class="opt">
                <input type="radio" name="audience" value={a.value} checked={i === 0} data-asks={a.asksHeadcount ? '1' : '0'} />
                <span class="opt-body">
                  <span class="opt-label">{a.label}</span>
                  <span class="opt-hint">{a.hint}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset class="step" id="step-headcount">
          <legend class="step-legend"><span class="step-num">02</span> Ilu pracowników zatrudniasz?</legend>
          <div class="opts">
            <label class="opt">
              <input type="radio" name="headcount" value="do-9" checked />
              <span class="opt-body">
                <span class="opt-label">Do 9 osób</span>
                <span class="opt-hint">W przeliczeniu na pełne etaty</span>
              </span>
            </label>
            <label class="opt">
              <input type="radio" name="headcount" value="od-10" />
              <span class="opt-body">
                <span class="opt-label">10 osób i więcej</span>
                <span class="opt-hint">Niższy pułap KFS</span>
              </span>
            </label>
          </div>
        </fieldset>

        <fieldset class="step">
          <legend class="step-legend"><span class="step-num" id="voiv-num">03</span> Województwo</legend>
          <select
            name="region"
            class="field-select"
            id="region-select"
            aria-label="Województwo — siedziba firmy lub miejsce zamieszkania"
          >
            {REGIONS_SORTED.map((r) => (
              <option value={r.slug}>{r.name}</option>
            ))}
          </select>
          <p class="mt-2 text-xs text-[var(--color-ink-4)]">
            Decyduje siedziba firmy, a dla osób prywatnych — miejsce zamieszkania.
          </p>
        </fieldset>
      </div>

      <!-- WYNIK -->
      <div class="lg:col-span-7">
        <div id="result" class="result" aria-live="polite"></div>
      </div>
    </div>
  </Section>

  <Section padding="tight">
    <p class="text-sm text-[var(--color-ink-4)] max-w-3xl">
      Analizator wskazuje właściwą instytucję i tryb złożenia wniosku. Pułapy podajemy tylko tam,
      gdzie wynikają z przepisów — dla ścieżki regionalnej wiążący jest regulamin konkretnego naboru.
      Dane regionalne zweryfikowane {formatVerified()}.
      <a class="src" href={PARP_OPERATORS_URL} target="_blank" rel="noopener">Wykaz operatorów PARP</a>.
    </p>
  </Section>

  <script type="application/json" id="advisor-data" set:html={JSON.stringify(results)} />
  <script type="application/json" id="region-data" set:html={JSON.stringify(
    Object.fromEntries(REGIONS_SORTED.map((r) => [r.slug, { ...r, statusLabel: STATUS_LABELS[r.status] }]))
  )} />
  <script type="application/json" id="price-data" set:html={JSON.stringify(PRICES)} />
</BaseLayout>

<script>
  const json = (id: string) => JSON.parse(document.getElementById(id)?.textContent ?? 'null');

  const results: Record<string, any> = json('advisor-data');
  const regions: Record<string, any> = json('region-data');
  const prices: { label: string; value: number }[] = json('price-data');
  const out = document.getElementById('result') as HTMLElement;
  const headcountStep = document.getElementById('step-headcount') as HTMLElement;
  const voivNum = document.getElementById('voiv-num') as HTMLElement;

  let price = prices[0].value;

  const ENT: Record<string, string> = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' };
  const esc = (s: unknown) => String(s).replace(/[&<>"]/g, (c) => ENT[c]);
  const zl = (n: number) => new Intl.NumberFormat('pl-PL').format(Math.round(n)) + ' zł';

  function current() {
    const audience = document.querySelector('input[name="audience"]:checked') as HTMLInputElement;
    const asks = audience.dataset.asks === '1';
    const hc = document.querySelector('input[name="headcount"]:checked') as HTMLInputElement | null;
    const headcount = asks && hc ? hc.value : '-';
    const region = (document.getElementById('region-select') as HTMLSelectElement).value;
    return { audience: audience.value, asks, headcount, region };
  }

  function renderPath(p: any, kfsRate?: number) {
    const calc = p.primary && kfsRate
      ? `<div class="calc">
           <div class="calc-row">
             <span>Cena szkolenia</span>
             <span class="calc-v">${zl(price)}</span>
           </div>
           <div class="calc-row calc-em">
             <span>Twój wkład po dofinansowaniu</span>
             <span class="calc-v">${zl(price * (1 - kfsRate))}</span>
           </div>
           <div class="calc-prices">
             ${prices.map((pr: { label: string; value: number }) => `<button type="button" data-price="${pr.value}" class="chip${pr.value === price ? ' chip-on' : ''}">${esc(pr.label)} — ${zl(pr.value)}</button>`).join('')}
           </div>
         </div>`
      : '';

    return `<article class="path${p.primary ? ' path-primary' : ''}">
      <header class="path-head">
        <h3 class="path-name">${esc(p.name)}</h3>
        ${p.coverage ? `<span class="path-cov">${esc(p.coverage)}</span>` : ''}
      </header>
      <div class="path-where">
        <span class="path-where-k">Gdzie składasz</span>
        <span class="path-where-v">${esc(p.where)}</span>
      </div>
      ${calc}
      <ol class="path-steps">${p.steps.map((s: string) => `<li>${esc(s)}</li>`).join('')}</ol>
      ${p.caveat ? `<p class="path-caveat">${esc(p.caveat)}</p>` : ''}
      <a class="path-link" href="${esc(p.url)}" target="_blank" rel="noopener">${esc(p.urlLabel)} →</a>
    </article>`;
  }

  function render() {
    const { audience, asks, headcount, region } = current();
    headcountStep.hidden = !asks;
    voivNum.textContent = asks ? '03' : '02';

    const r = results[`${audience}|${region}|${headcount}`];
    if (!r) { out.innerHTML = ''; return; }

    const reg = regions[region];
    const tone = reg.statusLabel.tone;
    const regionBadge = `<span class="badge badge-${tone}">${esc(reg.statusLabel.label)}</span>`;

    const regionBox = `<div class="region-box">
      <div class="region-head">
        <span class="region-name">${esc(reg.name)}</span>
        ${regionBadge}
      </div>
      ${reg.program ? `<div class="region-prog">${esc(reg.program)}</div>` : ''}
      ${reg.scope ? `<p class="region-note"><strong>Uwaga:</strong> program obejmuje tylko część województwa — ${esc(reg.scope)}.</p>` : ''}
      ${reg.coverage ? `<p class="region-l"><span>Dofinansowanie</span> ${esc(reg.coverage)}</p>` : ''}
      ${reg.limit ? `<p class="region-l"><span>Limit</span> ${esc(reg.limit)}</p>` : ''}
      ${reg.note ? `<p class="region-note">${esc(reg.note)}</p>` : ''}
    </div>`;

    out.innerHTML = `
      <div class="result-head">
        <h2 class="result-title">${esc(r.headline)}</h2>
        <p class="result-sum">${esc(r.summary)}</p>
      </div>
      ${regionBox}
      <div class="paths">${r.paths.map((p: any) => renderPath(p, r.kfsRate)).join('')}</div>
      <div class="help">
        <h3 class="help-t">Pomożemy Ci z wnioskiem</h3>
        <p class="help-d">Jeśli szkolisz się u nas, przygotowanie wniosku bierzemy na siebie — bezpłatnie.</p>
        <a href="/pomoc-z-wnioskiem/" class="btn btn-accent btn-sm">Zobacz, jak to działa</a>
      </div>`;
  }

  // Preselekcja z innych stron:
  //   z hero            → ?kim=pracodawca
  //   z mapy województw → ?region=slaskie
  const params = new URLSearchParams(location.search);
  const preset = params.get('kim');
  if (preset) {
    const target = document.querySelector(
      `input[name="audience"][value="${CSS.escape(preset)}"]`
    ) as HTMLInputElement | null;
    if (target) target.checked = true;
  }
  const presetRegion = params.get('region');
  if (presetRegion) {
    const sel = document.getElementById('region-select') as HTMLSelectElement | null;
    if (sel && regions[presetRegion]) sel.value = presetRegion;
  }

  document.addEventListener('change', (e) => {
    const t = e.target as HTMLElement | null;
    if (t?.matches?.('input[name="audience"], input[name="headcount"], #region-select')) render();
  });
  document.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement | null)?.closest?.('[data-price]') as HTMLElement | null;
    if (b) { price = Number(b.dataset.price); render(); }
  });
  render();
</script>

<style>
  .step { border: 0; padding: 0; margin: 0 0 2rem; }
  .step[hidden] { display: none; }
  .step-legend {
    display: flex; align-items: center; gap: 0.6rem;
    font-family: var(--font-display); font-size: 1.15rem;
    letter-spacing: -0.01em; color: var(--color-ink); margin-bottom: 0.9rem;
  }
  .step-num {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.1em;
    color: var(--color-accent); border: 1px solid var(--color-accent);
    border-radius: 999px; padding: 0.15rem 0.5rem;
  }
  .opts { display: grid; gap: 0.5rem; }
  .opt { display: block; cursor: pointer; }
  .opt input { position: absolute; opacity: 0; pointer-events: none; }
  .opt-body {
    display: block; padding: 0.85rem 1.1rem;
    background: var(--color-card-raised); border: 1px solid var(--color-rule);
    border-radius: 8px; transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .opt:hover .opt-body { border-color: var(--color-rule-strong); }
  .opt input:checked + .opt-body {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }
  .opt input:focus-visible + .opt-body { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .opt-label { display: block; font-weight: 500; color: var(--color-ink); }
  .opt-hint { display: block; font-size: 0.82rem; color: var(--color-ink-4); margin-top: 0.15rem; }

</style>

<!-- Panel wyniku powstaje w JS, wiec jego style musza byc globalne (zawezone do #result). -->
<style is:global>
  #result .result-head { margin-bottom: 1.5rem; }
  #result .result-title {
    font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.1rem);
    line-height: 1.1; letter-spacing: -0.02em; color: var(--color-ink);
  }
  #result .result-sum { margin-top: 0.75rem; color: var(--color-ink-3); line-height: 1.6; }

  #result .region-box {
    background: var(--color-card-raised); border: 1px solid var(--color-rule);
    border-radius: 8px; padding: 1.1rem 1.35rem; margin-bottom: 1.25rem;
  }
  #result .region-head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  #result .region-name { font-weight: 500; color: var(--color-ink); text-transform: capitalize; }
  #result .region-prog { font-family: var(--font-display); font-size: 1.15rem; color: var(--color-ink); margin-top: 0.3rem; }
  #result .region-l { font-size: 0.85rem; color: var(--color-ink-2); margin-top: 0.5rem; line-height: 1.5; }
  #result .region-l span {
    display: inline-block; min-width: 8.5rem; font-size: 0.68rem; text-transform: uppercase;
    letter-spacing: 0.1em; color: var(--color-ink-4);
  }
  #result .region-note { font-size: 0.82rem; color: var(--color-ink-3); margin-top: 0.6rem; line-height: 1.55; }

  #result .badge {
    font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.09em;
    padding: 0.2rem 0.55rem; border-radius: 999px; white-space: nowrap; font-weight: 500;
  }
  #result .badge-ok { background: var(--color-positive-soft); color: var(--color-positive); }
  #result .badge-warn { background: var(--color-warn-soft); color: var(--color-warn); }
  #result .badge-muted { background: var(--color-paper-deep); color: var(--color-ink-4); }

  #result .paths { display: grid; gap: 1rem; }
  #result .path {
    background: var(--color-card-raised); border: 1px solid var(--color-rule);
    border-radius: 8px; padding: 1.5rem;
  }
  #result .path-primary { border-color: var(--color-accent); box-shadow: 0 0 0 1px var(--color-accent); }
  #result .path-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.75rem; }
  #result .path-name { font-family: var(--font-display); font-size: 1.35rem; letter-spacing: -0.01em; color: var(--color-ink); }
  #result .path-cov { font-family: var(--font-display); font-style: italic; font-size: 1.3rem; color: var(--color-accent-deep); }
  #result .path-where {
    margin-top: 0.9rem; padding: 0.75rem 0.9rem;
    background: var(--color-paper-soft); border-radius: 6px;
  }
  #result .path-where-k {
    display: block; font-size: 0.66rem; text-transform: uppercase;
    letter-spacing: 0.11em; color: var(--color-ink-4);
  }
  #result .path-where-v { display: block; margin-top: 0.2rem; color: var(--color-ink); font-weight: 500; line-height: 1.45; }

  #result .calc { margin-top: 1rem; border: 1px dashed var(--color-rule-strong); border-radius: 6px; padding: 0.9rem 1rem; }
  #result .calc-row { display: flex; justify-content: space-between; gap: 1rem; font-size: 0.9rem; color: var(--color-ink-3); }
  #result .calc-row + .calc-row { margin-top: 0.4rem; }
  #result .calc-em { color: var(--color-ink); font-weight: 500; }
  #result .calc-v { font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  #result .calc-prices { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.8rem; }
  #result .chip {
    font-size: 0.75rem; padding: 0.3rem 0.65rem; border-radius: 999px;
    border: 1px solid var(--color-rule-strong); background: transparent;
    color: var(--color-ink-3); cursor: pointer;
  }
  #result .chip-on { border-color: var(--color-accent); color: var(--color-accent-deep); }

  #result .path-steps { margin: 1rem 0 0; padding-left: 1.2rem; display: grid; gap: 0.4rem; }
  #result .path-steps li { font-size: 0.9rem; color: var(--color-ink-2); line-height: 1.5; }
  #result .path-caveat {
    margin-top: 0.9rem; font-size: 0.82rem; color: var(--color-ink-3);
    border-left: 3px solid var(--color-warn); padding-left: 0.75rem; line-height: 1.55;
  }
  #result .path-link {
    display: inline-block; margin-top: 1rem; font-size: 0.875rem; font-weight: 500;
    color: var(--color-accent-deep); text-decoration: underline; text-underline-offset: 3px;
  }

  #result .help {
    margin-top: 1.25rem; padding: 1.35rem 1.5rem; border-radius: 8px;
    background: var(--color-accent-wash); border: 1px solid var(--color-marker);
  }
  #result .help-t { font-family: var(--font-display); font-size: 1.2rem; color: var(--color-ink); }
  #result .help-d { margin: 0.4rem 0 0.9rem; font-size: 0.9rem; color: var(--color-ink-2); }

  #result .src { color: var(--color-accent-deep); text-decoration: underline; text-underline-offset: 3px; }

</style>
