---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import PolandMap from '../../components/ui/PolandMap.astro';
import { REGIONS_SORTED, STATUS_LABELS, PARP_OPERATORS_URL, BUR_URL } from '../../lib/regions';

const activeCount = REGIONS_SORTED.filter((r) => r.status === 'aktywny').length;

const steps = [
  { t: 'Załóż konto w Bazie Usług Rozwojowych', d: 'Rejestracja przez login.gov.pl — profil zaufany, e-dowód albo bankowość elektroniczna.' },
  { t: 'Znajdź operatora dla swojego województwa', d: 'Operator jest przypisany do regionu, a czasem do konkretnego podregionu. Jego regulamin określa warunki.' },
  { t: 'Złóż wniosek u operatora', d: 'Nie w Bazie Usług Rozwojowych — to katalog usług, a nie system wniosków. Nabory bywają zamykane w ciągu godzin od otwarcia.' },
  { t: 'Odbierz ID wsparcia', d: 'Operator nadaje je po podpisaniu umowy. Bez niego zapis na szkolenie jest zwykłym zakupem komercyjnym.' },
  { t: 'Zapisz się na szkolenie, wpisując ID wsparcia', d: 'Dopiero wtedy usługa jest objęta dofinansowaniem.' },
  { t: 'Zrealizuj i rozlicz', d: 'Model rozliczenia zależy od regionu: refundacja, płatność operatora do dostawcy albo system bonowy. Na koniec obowiązkowa ocena usługi.' },
];
---

<BaseLayout
  title="Dofinansowanie szkoleń według województw — gdzie złożyć wniosek"
  description="Programy dofinansowania szkoleń dla osób dorosłych i firm w podziale na województwa: operator, poziom wsparcia i status naborów. Dane ze źródeł urzędowych."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Dofinansowanie', url: '/dofinansowanie/' },
      { name: 'Województwa' },
    ]} />
  </div>

  <Section padding="default">
    <div class="max-w-3xl">
      <div class="eyebrow">Ścieżka regionalna</div>
      <h1 class="mt-5 page-h1">
        Dofinansowanie <span class="display-italic">województwo po województwie</span>.
      </h1>
      <p class="lead mt-6 text-[var(--color-ink-3)]">
        Poza Krajowym Funduszem Szkoleniowym działa druga, niezależna ścieżka: środki europejskie
        rozdzielane regionalnie. Nie ma tu jednego ogólnopolskiego programu — każde województwo ma
        własnego operatora, własny regulamin i własny kalendarz naborów.
      </p>
    </div>
  </Section>

  <Section surface="paper-soft" padding="default" counter="01" eyebrow="Wybierz województwo" id="mapa">
    <div class="sec-head">
      <h2 class="sec-h2">
        Kliknij swój <span class="display-italic">region</span>.
      </h2>
      <p class="sec-intro">
        Dane potwierdziliśmy u operatorów 25 lipca 2026 r. Wiążący pozostaje regulamin konkretnego
        naboru — pułapy i limity zmieniają się między rundami.
      </p>
    </div>

    <div class="picker-wrap" id="woj-picker">
      <div class="picker-map">
        <PolandMap target="woj" />
      </div>

      <div class="picker-panel">
        <label class="sel-lbl" for="woj-select">Albo wybierz z listy</label>
        <select id="woj-select" class="sel">
          <option value="">— województwo —</option>
          {REGIONS_SORTED.map((r) => (
            <option value={r.slug}>{r.name}</option>
          ))}
        </select>

        <div class="panels">
          {REGIONS_SORTED.map((r) => (
            <article class="reg panel" id={`woj-${r.slug}`} tabindex="-1">
              <header class="reg-head">
                <h3 class="reg-name">{r.name}</h3>
                <span class={`badge badge-${STATUS_LABELS[r.status].tone}`}>{STATUS_LABELS[r.status].label}</span>
              </header>
              {r.program && <p class="reg-prog">{r.program}</p>}
              {r.operator && <p class="reg-op">{r.operator}</p>}
              {r.scope && (
                <p class="reg-scope">
                  <strong>Tylko część województwa:</strong> {r.scope}
                </p>
              )}
              {(r.coverage || r.limit) && (
                <dl class="reg-dl">
                  {r.coverage && <div><dt>Dofinansowanie</dt><dd>{r.coverage}</dd></div>}
                  {r.limit && <div><dt>Limit</dt><dd>{r.limit}</dd></div>}
                </dl>
              )}
              {r.note && <p class="reg-note">{r.note}</p>}
              {!r.program && (
                <p class="reg-note">
                  Nie potwierdziliśmy aktualnego programu dla osób dorosłych w tym województwie.
                  Nie zgadujemy — sprawdź bezpośrednio w wykazie operatorów.
                </p>
              )}
              <div class="reg-actions">
                <a class="reg-link" href={r.url ?? PARP_OPERATORS_URL} target="_blank" rel="noopener">
                  {r.url ? 'Strona operatora →' : 'Wykaz operatorów PARP →'}
                </a>
                <a class="reg-link reg-link-soft" href={`/dofinansowanie/kalkulator/?region=${r.slug}`}>
                  Sprawdź swoją ścieżkę →
                </a>
              </div>
              {r.verified && (
                <p class="reg-ver">Zweryfikowano {r.verified.split('-').reverse().join('.')}</p>
              )}
            </article>
          ))}

          <div class="panel-prompt">
            <p class="prompt-t">Wybierz województwo</p>
            <p class="prompt-d">
              Kliknij region na mapie albo wybierz go z listy. Pokażemy operatora, poziom
              dofinansowania i miejsce składania wniosku.
            </p>
            <p class="prompt-s">
              {activeCount} z 16 województw ma potwierdzony program dla osób dorosłych.
            </p>
          </div>
        </div>
      </div>
    </div>
  </Section>

  <Section padding="default" counter="02" eyebrow="Jak to działa">
    <div class="sec-head">
      <h2 class="sec-h2">
        Kolejność ma <span class="display-italic">znaczenie</span>.
      </h2>
      <p class="sec-intro">
        Najczęstszy błąd to zapisanie się na szkolenie przed uzyskaniem ID wsparcia. Wtedy usługa jest
        zwykłym zakupem i dofinansowanie przepada.
      </p>
    </div>

    <ol class="steps">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step-no">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="step-t">{s.t}</h3>
          <p class="step-d">{s.d}</p>
        </li>
      ))}
    </ol>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/dofinansowanie/kalkulator/" class="btn btn-primary">Sprawdź swoją ścieżkę</a>
      <a href="/pomoc-z-wnioskiem/" class="btn btn-ghost">Pomożemy z wnioskiem</a>
    </div>
  </Section>

  <Section surface="paper-soft" padding="tight">
    <div class="eyebrow">Źródła</div>
    <ul class="mt-4 space-y-1.5 text-sm">
      <li><a class="src" href={PARP_OPERATORS_URL} target="_blank" rel="noopener">PARP — dofinansowania w BUR i wykaz operatorów</a></li>
      <li><a class="src" href={BUR_URL} target="_blank" rel="noopener">Baza Usług Rozwojowych</a></li>
    </ul>
    <p class="mt-4 text-xs text-[var(--color-ink-4)]">Dane operatorów zweryfikowane 25.07.2026.</p>
  </Section>
</BaseLayout>

<script>
  // Wzbogacenie interakcji. Bez tego skryptu wybór nadal działa — panel
  // pokazuje się przez :target, bo każde województwo na mapie to odnośnik.
  // Ze skryptem przejmujemy kliknięcia, żeby wybór regionu nie przewijał
  // strony do panelu (kotwica potrafi skoczyć o kilkaset pikseli).
  const picker = document.getElementById('woj-picker');
  const select = document.getElementById('woj-select') as HTMLSelectElement | null;

  if (picker && select) {
    picker.classList.add('js');

    const links = Array.from(picker.querySelectorAll<HTMLAnchorElement>('a[data-slug]'));
    const panels = Array.from(picker.querySelectorAll<HTMLElement>('.panel'));

    // Adresu nie przepisujemy: replaceState z kotwicą pasującą do id panelu
    // przewija stronę do tego panelu, a chcemy, żeby mapa została na miejscu.
    // Wejście z adresu #woj-<slug> nadal działa — obsługuje je fromHash().
    function show(slug: string, reveal: boolean) {
      for (const a of links) a.setAttribute('aria-current', String(a.dataset.slug === slug));
      for (const p of panels) p.classList.toggle('is-on', p.id === `woj-${slug}`);
      if (select && select.value !== slug) select.value = slug;

      // Na desktopie panel stoi obok mapy i jest już widoczny — nie ruszamy
      // strony. Na wąskim ekranie leży pod mapą, więc przewijamy do niego
      // tyle, ile trzeba, żeby wybór nie wyglądał na brak reakcji.
      if (!reveal || !slug) return;
      const panel = document.getElementById(`woj-${slug}`);
      if (!panel) return;
      const r = panel.getBoundingClientRect();
      if (r.top < 80 || r.bottom > window.innerHeight) {
        panel.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    }

    function fromHash() {
      const m = /^#woj-([a-z-]+)$/.exec(location.hash);
      show(m ? m[1] : '', false);
    }

    for (const a of links) {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(a.dataset.slug ?? '', true);
      });
    }

    select.addEventListener('change', () => show(select.value, true));
    window.addEventListener('hashchange', fromHash);
    fromHash();
  }
</script>

<style>
  /* Wspólny nagłówek sekcji — tytuł po lewej, wprowadzenie po prawej. */
  .sec-head {
    display: grid;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .sec-head {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 3rem;
      margin-bottom: 3rem;
    }
  }
  .sec-h2 {
    font-size: clamp(1.65rem, 3.4vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .sec-intro { color: var(--color-ink-3); font-size: 0.94rem; line-height: 1.62; }

  /* Mapa + panel wybranego województwa */
  .picker-wrap {
    display: grid;
    gap: 2rem;
    align-items: start;
  }
  @media (min-width: 900px) {
    .picker-wrap {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      gap: 3rem;
    }
  }
  .picker-map { max-width: 34rem; margin-inline: auto; width: 100%; }
  .picker-panel { display: flex; flex-direction: column; gap: 0.6rem; }

  .sel-lbl {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-4);
    font-weight: 600;
  }
  .sel {
    width: 100%;
    padding: 0.65rem 0.85rem;
    font-size: 0.95rem;
    color: var(--color-ink);
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule-strong);
    border-radius: 8px;
    text-transform: capitalize;
  }
  .sel:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  /* Panele: domyślnie ukryte, pokazuje je :target — czyli klik w mapę albo
     wejście z adresu z kotwicą. Podpowiedź znika, gdy któryś jest wybrany.
     Gdy działa JavaScript (klasa .js), sterujemy klasą .is-on zamiast :target,
     bo przeskok kotwicy przewijałby stronę przy każdym kliknięciu w mapę. */
  .panels { position: relative; margin-top: 0.4rem; }
  .panel { display: none; scroll-margin-top: 7rem; }
  .panel:target { display: block; }
  .panel:focus { outline: none; }
  .panels:has(.panel:target) .panel-prompt { display: none; }

  #woj-picker.js .panel:target { display: none; }
  #woj-picker.js .panel.is-on { display: block; }
  #woj-picker.js .panels:has(.panel:target) .panel-prompt { display: block; }
  #woj-picker.js .panels:has(.panel.is-on) .panel-prompt { display: none; }

  .panel-prompt {
    background: var(--color-card);
    border: 1px dashed var(--color-rule-strong);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .prompt-t {
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }
  .prompt-d {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--color-ink-3);
  }
  .prompt-s {
    margin-top: 0.9rem;
    padding-top: 0.85rem;
    border-top: 1px dotted var(--color-rule-strong);
    font-size: 0.8rem;
    color: var(--color-ink-4);
  }

  .reg {
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    padding: 1.5rem;
  }
  .reg-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin-top: 1rem;
  }
  .reg-link-soft { color: var(--color-ink-3); }
  .reg-ver {
    margin-top: 0.9rem;
    font-size: 0.7rem;
    color: var(--color-ink-4);
  }

  /* Kroki */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  @media (min-width: 720px) { .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1200px) { .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .step {
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    padding: 1.35rem 1.5rem;
  }
  .step-no {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.6rem;
  }
  .step-t {
    font-family: var(--font-display);
    font-size: 1.15rem;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--color-ink);
  }
  .step-d { margin-top: 0.5rem; font-size: 0.88rem; line-height: 1.6; color: var(--color-ink-3); }

  .reg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.6rem;
  }
  .reg-name {
    font-family: var(--font-display);
    font-size: 1.4rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-transform: capitalize;
  }
  .reg-prog { font-weight: 500; color: var(--color-ink-2); }
  .reg-op { font-size: 0.85rem; color: var(--color-ink-4); margin-top: 0.15rem; }
  .reg-scope {
    margin-top: 0.7rem;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--color-ink-3);
    border-left: 3px solid var(--color-warn);
    padding-left: 0.7rem;
  }
  .reg-scope strong { color: var(--color-ink); font-weight: 500; }
  .reg-dl { margin-top: 0.9rem; display: grid; gap: 0.5rem; }
  .reg-dl > div { display: grid; gap: 0.1rem; }
  .reg-dl dt {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-ink-4);
  }
  .reg-dl dd { margin: 0; font-size: 0.88rem; color: var(--color-ink-2); line-height: 1.5; }
  .reg-note { margin-top: 0.8rem; font-size: 0.82rem; color: var(--color-ink-3); line-height: 1.55; }
  .reg-link {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .badge {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    white-space: nowrap;
    font-weight: 500;
  }
  .badge-ok { background: var(--color-positive-soft); color: var(--color-positive); }
  .badge-warn { background: var(--color-warn-soft); color: var(--color-warn); }
  .badge-muted { background: var(--color-paper-deep); color: var(--color-ink-4); }
  .src { color: var(--color-accent-deep); text-decoration: underline; text-underline-offset: 3px; }
</style>
