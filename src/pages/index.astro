---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Accordion from '../components/ui/Accordion.astro';
import { SITE, TRUST_SIGNALS } from '../lib/site';
import { AUDIENCES } from '../lib/advisor';
import { getCatalog, getNearestOpenService, plainDate, formatNumeric, dateParts, lowestPrice, isRecruitmentOpen } from '../lib/bur';
import { formatPrice } from '../lib/format';

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order).slice(0, 5);

const trainer = await getEntry('trainers', 'przemek-nowak');
// Zdjęcie sprawdzamy w czasie builda — bez pliku <img> dałby 404 i pustą ramkę.
const trainerPhotoOk = Boolean(
  trainer?.data.photo && fs.existsSync(path.join(path.resolve('./public'), trainer.data.photo))
);
const trainerInitials = (trainer?.data.name ?? '')
  .split(/\s+/)
  .slice(0, 2)
  .map((w) => w[0])
  .join('');

// Wszystko poniżej pochodzi z katalogu w Bazie Usług Rozwojowych — strona
// pokazuje realną ofertę i realne terminy, a nie osobno utrzymywany opis.
const catalog = getCatalog();
// Na stronie głównej pokazujemy trzy oferty z najbliższymi otwartymi zapisami.
const featured = catalog.filter((o) => o.terms.some(isRecruitmentOpen)).slice(0, 3);
const nearestEdition = getNearestOpenService();
const nearestDate = plainDate(nearestEdition?.startDate);
const nearestParts = nearestDate ? dateParts(nearestDate) : null;
const nearestOffering = nearestEdition
  ? catalog.find((o) => o.terms.some((t) => t.id === nearestEdition.id))
  : undefined;
const cheapest = lowestPrice();
// Do bloku porównania kosztów bierzemy najtańsze realne szkolenie z katalogu,
// żeby przykładowa kwota odpowiadała czemuś, co faktycznie można kupić.
const example = cheapest ?? 0;
const exampleKfs90 = Math.round(example * 0.10 * 100) / 100;
const exampleKfs70 = Math.round(example * 0.30 * 100) / 100;

const personas = [
  { role: 'HR & Rekrutacja', insight: 'Generujesz feedback 360, ogłoszenia rekrutacyjne i analizujesz CV w 1/3 czasu — bez wycieku danych kandydatów.' },
  { role: 'Sprzedaż B2B', insight: 'Personalizowane sekwencje cold mail dla 50 firm — w godzinę zamiast tygodnia. CRM dziękuje.' },
  { role: 'Finanse & Księgowość', insight: 'Streszczasz raporty i analizujesz pliki Excel głosem zwykłym. Nie kuglujesz formuł — pytasz.' },
  { role: 'Marketing & Treść', insight: 'Briefy, posty, scenariusze — szybciej. Ale co najważniejsze: w Twoim głosie marki, nie w głosie ChatGPT.' },
  { role: 'Asystent zarządu', insight: 'Streszczenia spotkań z cytowaniami, prezentacje z briefu jednym akapitem, korespondencja z trzech języków.' },
  { role: 'Mikroprzedsiębiorca / JDG', insight: 'Robisz pracę 3 osób — bez 3 osób. AI to twój zespół, którego dotąd nie miałeś.' },
];

---

<BaseLayout
  title="Next Mind Academy — szkolenia AI dla pracowników biurowych | dofinansowanie do 90%"
  description={SITE.description}
  hideHeaderBorder={true}
>
  <!-- ====================================================
       S1 — HERO
       Dwie kolumny: obietnica po lewej, wybór typu podmiotu po prawej.
       Selektor musi być widoczny bez przewijania — to pierwszy krok
       ścieżki użytkownika, więc dzieli miejsce z nagłówkiem, a nie
       chowa się pod nim.
       ==================================================== -->
  <section class="hero relative overflow-hidden">
    <!-- Decorative background composition -->
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-glow"></div>
      <svg class="hero-arc" viewBox="0 0 800 800" fill="none">
        <circle cx="400" cy="400" r="320" stroke="#0A1530" stroke-width="0.5" stroke-dasharray="2 6" opacity="0.12" />
        <circle cx="400" cy="400" r="240" stroke="#0A1530" stroke-width="0.5" opacity="0.12" />
        <circle cx="400" cy="400" r="160" stroke="#2D5BFF" stroke-width="0.7" opacity="0.35" />
      </svg>
    </div>

    <div class="container-edge relative pt-7 lg:pt-10 pb-10 lg:pb-14">
      <div class="grid lg:grid-cols-12 gap-x-12 gap-y-7 lg:gap-y-9 items-start">
        <!-- Obietnica — kolumny 1-7 -->
        <div class="lg:col-span-7 reveal reveal-1">
          <div class="hero-meta">
            <span class="tabular-nums">N<span class="text-[var(--color-accent)]">/</span>01</span>
            <span class="rule-dotted flex-1 max-w-[3.5rem]"></span>
            <span class="hero-meta-label">Akademia AI · Edycja 2026</span>
          </div>

          <h1 class="hero-h1">
            Naucz się <span class="display-italic">AI w&nbsp;pracy biurowej</span>.<br />
            Z&nbsp;dofinansowaniem do <span class="hero-pct">90%</span>.
          </h1>

          <p class="hero-lead">
            Praktyczne szkolenia z&nbsp;<strong>ChatGPT, Gemini, Claude i&nbsp;NotebookLM</strong>
            dla pracowników spoza IT. Online live, zaświadczenie z&nbsp;mapowaniem
            efektów uczenia się na ramę DigComp 2.2.
          </p>

          <div class="hero-actions">
            <a href="#szkolenia" class="btn btn-primary">
              Zobacz szkolenia
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M13 8L8 3M13 8L8 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>

            {nearestEdition && nearestParts ? (
              <a href={nearestOffering ? `/szkolenia/${nearestOffering.slug}/` : '/szkolenia/'} class="hero-next">
                <span class="hero-next-dot" aria-hidden="true"></span>
                <span>
                  Najbliższa edycja <strong>{nearestParts.day}.{nearestParts.month}.{nearestParts.year}</strong>
                  <span class="hero-next-open"> — zapisy otwarte</span>
                </span>
              </a>
            ) : (
              <a href="/kontakt/" class="hero-next">
                <span>Ustalamy terminy kolejnych edycji — <strong>zapytaj o termin</strong></span>
              </a>
            )}
          </div>
        </div>

        <!-- Selektor typu podmiotu — wejście do analizatora ścieżki finansowania -->
        <aside class="lg:col-span-5 reveal reveal-2">
          <div class="picker">
            <h2 class="picker-q">Jakim jesteś podmiotem?</h2>
            <p class="picker-sub">
              Wybierz, a&nbsp;pokażemy, z&nbsp;czego możesz się finansować i&nbsp;gdzie złożyć wniosek.
            </p>
            <div class="picker-grid">
              {AUDIENCES.map((a) => (
                <a href={`/dofinansowanie/kalkulator/?kim=${a.value}`} class="picker-card">
                  <span class="picker-text">
                    <span class="picker-label">{a.label}</span>
                    <span class="picker-hint">{a.hint}</span>
                  </span>
                  <span class="picker-go" aria-hidden="true">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
                      <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
            <p class="picker-note">
              Pułap zależy od tego, kto wnioskuje: <strong>do 90%</strong> dla firm do 9&nbsp;osób
              i&nbsp;podmiotów bez pracowników, <strong>do 70%</strong> dla większych.
              Osoby prywatne mają odrębne ścieżki.
            </p>
          </div>
        </aside>
      </div>

      <!-- Pasek zaufania — jedna linia, na dole hero -->
      <div class="hero-trust reveal reveal-3">
        <div class="rule-line mb-4"></div>
        <ul class="trust-row">
          {TRUST_SIGNALS.map((signal) => (
            <li class="trust-item">
              <span class="trust-label">{signal.label}</span>
              <span class="trust-detail">{signal.detail}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ====================================================
       S2 — MARQUEE / Tools
       ==================================================== -->
  <section class="marquee-section py-8 border-y border-[var(--color-rule)] bg-[var(--color-paper-soft)]">
    <div class="marquee">
      <div class="marquee-track">
        {[...Array(2)].map(() => (
          <>
            <span class="marquee-item">ChatGPT</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Gemini</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Claude</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">NotebookLM</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Microsoft Copilot</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Custom GPT</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Gemini Gem</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Claude Projects</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Zapier</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Perplexity</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Gamma</span>
            <span class="marquee-dot">●</span>
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================
       S3 — Cost-logic strip (USP #1: price)
       Editorial financial moment
       ==================================================== -->
  <Section surface="paper" padding="default">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="section-counter">02</span>
          <span class="rule-dotted flex-1 max-w-[3rem]"></span>
          <span class="eyebrow eyebrow--centered">Logika kosztu</span>
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-[3.5rem] leading-[1.02] tracking-tight">
          Cena rynkowa <span class="display-italic text-[var(--color-ink-4)]">jest tylko</span> ceną&nbsp;rynkową.
        </h2>
        <p class="mt-6 text-[var(--color-ink-3)] leading-relaxed">
          Większość pracowników biurowych w Polsce ma prawo do dofinansowania szkoleń w 80–90%.
          Z KFS albo z programu regionalnego w swoim województwie. Po prostu — większość o tym nie wie.
        </p>
        <a href="/dofinansowanie/kalkulator/" class="mt-8 inline-flex items-center gap-2 group">
          <span class="btn btn-primary">Sprawdź swoje dofinansowanie</span>
        </a>
      </div>

      <div class="lg:col-span-7">
        <div class="cost-card">
          <div class="cost-header">
            <span class="eyebrow !text-[var(--color-paper)] opacity-70">Przykład: szkolenie jednodniowe</span>
            <span class="text-[var(--color-marker)] text-xs font-mono">{nearestDate ? `edycja ${formatNumeric(nearestDate)}` : 'termin w ustalaniu'}</span>
          </div>

          <div class="cost-row">
            <span class="cost-label">Cena katalogowa netto</span>
            <span class="cost-value cost-strike">{formatPrice(example)}</span>
          </div>
          <div class="cost-row">
            <span class="cost-label">Z KFS — firma od 10 osób (70%)</span>
            <span class="cost-value">{formatPrice(exampleKfs70)}</span>
          </div>
          <div class="cost-row cost-row-final">
            <span class="cost-label-final">
              <span class="display-italic text-[var(--color-marker)]">Z KFS Priorytet 3</span> — do 9 osób, 90%
            </span>
            <span class="cost-value-final">{formatPrice(exampleKfs90)}</span>
          </div>

          <p class="mt-6 text-[0.72rem] text-[var(--color-paper)] opacity-50 leading-relaxed">
            Pułapy KFS wynikają z ustawy i zależą od liczby zatrudnionych. Wsparcie regionalne rozliczane jest
            osobno, a jego poziom ustala operator w regulaminie naboru. Stan prawny: 2026 r.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- ====================================================
       S4 — THREE COURSES
       ==================================================== -->
  <Section surface="paper-soft" padding="default" id="szkolenia">
    <div class="section-header">
      <div class="flex items-center gap-3">
        <span class="section-counter">03</span>
        <span class="rule-dotted flex-1 max-w-[3rem]"></span>
        <span class="eyebrow eyebrow--centered">Program edukacyjny</span>
      </div>
      <div class="grid md:grid-cols-12 gap-x-8 items-end">
        <h2 class="md:col-span-7 text-4xl md:text-5xl lg:text-[3.75rem] leading-[1.02] tracking-tight">
          Trzy poziomy. Jedna <span class="display-italic">droga</span>.
        </h2>
        <p class="md:col-span-5 lead text-[var(--color-ink-3)] mt-6 md:mt-0">
          Od pierwszego promptu do własnego asystenta zintegrowanego z Twoim arkuszem.
          Każdy krok ma swój moment, swój rytuał, swoje zadanie do wykonania w realnej pracy.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-5">
      {featured.map((o) => {
        const next = o.terms.find(isRecruitmentOpen);
        return (
          <a href={`/szkolenia/${o.slug}/`} class="hp-card">
            <span class="hp-card-meta">
              {o.hours ? `${o.hours} h` : o.days === 1 ? '1 dzień' : `${o.days} dni`}
              {o.seatsMin && o.seatsMax && ` · ${o.seatsMin}–${o.seatsMax} osób`}
            </span>
            <h3 class="hp-card-title bur-title">{o.title}</h3>
            <div class="hp-card-foot">
              {o.priceNet !== null && <span class="hp-card-price">{formatPrice(o.priceNet)} netto</span>}
              {next?.startDate && (
                <span class="hp-card-next">od {formatNumeric(plainDate(next.startDate)!)}</span>
              )}
            </div>
          </a>
        );
      })}
    </div>

    <div class="mt-8">
      <a href="/szkolenia/" class="btn btn-secondary">
        Zobacz wszystkie {catalog.length} szkoleń
      </a>
    </div>
  </Section>

  <!-- ====================================================
       S5 — DLA KOGO (personas)
       ==================================================== -->
  <Section surface="paper" padding="default">
    <div class="section-header">
      <div class="flex items-center gap-3">
        <span class="section-counter">04</span>
        <span class="rule-dotted flex-1 max-w-[3rem]"></span>
        <span class="eyebrow eyebrow--centered">Dla kogo</span>
      </div>
      <div class="grid md:grid-cols-12 gap-x-8 items-end">
        <h2 class="md:col-span-7 text-4xl md:text-5xl lg:text-[3.75rem] leading-[1.02] tracking-tight">
          Sześć ról. Każda z innym <span class="display-italic">"a co mi z tego"</span>.
        </h2>
        <p class="md:col-span-5 lead text-[var(--color-ink-3)] mt-6 md:mt-0">
          Nie sprzedajemy „transformacji". Pokazujemy konkretne zastosowania dla Twojej roli — nie roli abstrakcyjnego pracownika.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-rule)] border border-[var(--color-rule)] rounded-lg overflow-hidden">
      {personas.map((p, i) => (
        <article class="persona-card">
          <div class="flex items-baseline justify-between mb-4">
            <span class="font-mono text-[0.7rem] text-[var(--color-ink-4)] tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <span class="display-italic text-2xl text-[var(--color-accent)]">{p.role.split(' ')[0]}</span>
          </div>
          <h3 class="font-display text-[1.625rem] tracking-tight leading-[1.1] mb-3">
            {p.role}
          </h3>
          <p class="text-[0.95rem] text-[var(--color-ink-3)] leading-relaxed">
            {p.insight}
          </p>
        </article>
      ))}
    </div>
  </Section>

  <!-- ====================================================
       S6 — TRENER (editorial portrait moment)
       ==================================================== -->
  <Section surface="card" padding="default" class="border-y border-[var(--color-rule)]">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <div class="trainer-portrait">
          <div class="trainer-portrait-frame">
            {/* Zdjęcie, gdy jest w public/; inaczej monogram — bez rysowanej
                sylwetki, która udawała portret konkretnej osoby. */}
            {trainerPhotoOk ? (
              <img
                src={trainer!.data.photo}
                alt={`${trainer!.data.name} — ${trainer!.data.title}`}
                class="trainer-portrait-img"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="trainer-portrait-mono" aria-hidden="true">
                <span>{trainerInitials}</span>
              </div>
            )}
            <div class="trainer-portrait-marker">
              <div class="text-[0.65rem] uppercase tracking-[0.18em] text-[var(--color-ink-4)] font-mono">{trainer?.data.title}</div>
              <div class="font-display font-bold text-2xl text-[var(--color-ink)] mt-0.5">{trainer?.data.name}</div>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 mb-3">
          <span class="section-counter">05</span>
          <span class="rule-dotted flex-1 max-w-[3rem]"></span>
          <span class="eyebrow eyebrow--centered">Kto prowadzi</span>
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-[3.5rem] leading-[1.05] tracking-tight">
          „Najlepszy prompt napisał ktoś, kto rozumie&nbsp;<span class="display-italic">problem</span>.
          Nie ten, kto rozumie modele."
        </h2>
        <p class="mt-6 text-[var(--color-ink-3)] leading-relaxed max-w-2xl">
          {trainer?.data.shortBio}
        </p>

        <!-- Zamiast liczby godzin i uczestników — obszary, które prowadzi.
             Tamtych liczb nie mamy skąd potwierdzić. -->
        {trainer && trainer.data.focus.length > 0 && (
          <ul class="mt-8 flex flex-wrap gap-2 max-w-2xl">
            {trainer.data.focus.map((f) => (
              <li class="hp-tag">{f}</li>
            ))}
          </ul>
        )}

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/trenerzy/" class="btn btn-secondary">Poznaj trenerów</a>
          <a href={trainer?.data.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">
            LinkedIn
            <svg class="w-3.5 h-3.5" viewBox="0 0 12 12" fill="none">
              <path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- ====================================================
       S7 — DOFINANSOWANIE (timeline)
       ==================================================== -->
  <Section surface="paper" padding="default">
    <div class="section-header">
      <div class="flex items-center gap-3">
        <span class="section-counter">06</span>
        <span class="rule-dotted flex-1 max-w-[3rem]"></span>
        <span class="eyebrow eyebrow--centered">Mechanika dofinansowania</span>
      </div>
      <div class="grid md:grid-cols-12 gap-x-8 items-end">
        <h2 class="md:col-span-7 text-4xl md:text-5xl lg:text-[3.75rem] leading-[1.02] tracking-tight">
          Trzy kroki do <span class="display-italic">płacenia</span> dziesiątej części.
        </h2>
        <p class="md:col-span-5 lead text-[var(--color-ink-3)] mt-6 md:mt-0">
          BUR brzmi urzędowo, ale w praktyce to formularz na 15 minut. Pomożemy go wypełnić.
        </p>
      </div>
    </div>

    <ol class="timeline">
      <li class="timeline-step">
        <div class="timeline-marker"><span>1</span></div>
        <div class="timeline-content">
          <h3 class="timeline-title">Wybierasz szkolenie</h3>
          <p class="timeline-desc">Klikasz „Zobacz program", czytasz, wybierasz konkretną edycję. Nasze szkolenia są wpisane do BUR — to warunek formalny dofinansowania.</p>
          <span class="timeline-time">~5 min</span>
        </div>
      </li>

      <li class="timeline-step">
        <div class="timeline-marker"><span>2</span></div>
        <div class="timeline-content">
          <h3 class="timeline-title">Składasz wniosek u operatora</h3>
          <p class="timeline-desc">Program regionalny albo KFS przez urząd pracy. Pomożemy skompletować dokumenty i napisać uzasadnienie — to najczęstszy powód zwrotu wniosku.</p>
          <span class="timeline-time">2–4 tygodnie na decyzję</span>
        </div>
      </li>

      <li class="timeline-step">
        <div class="timeline-marker"><span>3</span></div>
        <div class="timeline-content">
          <h3 class="timeline-title">Bierzesz udział i&nbsp;płacisz tylko swój wkład</h3>
          <p class="timeline-desc">Przy pokryciu 90% płacisz jedną dziesiątą ceny — resztę instytucja finansująca rozlicza bezpośrednio z dostawcą.</p>
          <span class="timeline-time">Wkład 10–20%</span>
        </div>
      </li>
    </ol>

    <div class="mt-12 flex flex-wrap gap-3">
      <a href="/dofinansowanie/bur-jak-zapisac/" class="btn btn-primary">BUR krok po kroku</a>
      <a href="/dofinansowanie/kalkulator/" class="btn btn-ghost">Kalkulator dofinansowania</a>
    </div>
  </Section>

  <!-- ====================================================
       S8 — SPOŁECZNOŚĆ I MATERIAŁY (lead magnet)
       ==================================================== -->
  <Section surface="paper-soft" padding="default">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 mb-3">
          <span class="section-counter">07</span>
          <span class="rule-dotted flex-1 max-w-[3rem]"></span>
          <span class="eyebrow eyebrow--centered">Po szkoleniu</span>
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-[3.5rem] leading-[1.04] tracking-tight">
          Materiały, które <span class="display-italic">nie wracają</span> do szuflady.
        </h2>
        <p class="lead mt-6 text-[var(--color-ink-3)]">
