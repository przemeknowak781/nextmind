---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Accordion from '../components/ui/Accordion.astro';
import CourseCard from '../components/courses/CourseCard.astro';
import { SITE, TRUST_SIGNALS } from '../lib/site';
import { AUDIENCES } from '../lib/advisor';
import { getNearestEdition, getUpcomingByCourse, formatEditionNumeric, splitEditionDate } from '../lib/editions';
import { formatDateShort, formatPrice } from '../lib/format';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const editions = await getCollection('editions');
const faqs = (await getCollection('faqs')).sort((a, b) => a.data.order - b.data.order).slice(0, 5);

const trainer = await getEntry('trainers', 'przemek-nowak');

const upcomingByCourse = await getUpcomingByCourse();
// Bez fallbacku na termin z przeszłości — wcześniej strona reklamowała minione edycje.
const nearestEdition = await getNearestEdition();
const nearestCourse = courses.find((c) => c.data.slug === nearestEdition?.data.courseSlug);
const nearestDate = nearestEdition ? new Date(nearestEdition.data.date) : null;
const nearestParts = nearestDate ? splitEditionDate(nearestDate) : null;

const personas = [
  { role: 'HR & Rekrutacja', insight: 'Generujesz feedback 360, ogłoszenia rekrutacyjne i analizujesz CV w 1/3 czasu — bez wycieku danych kandydatów.' },
  { role: 'Sprzedaż B2B', insight: 'Personalizowane sekwencje cold mail dla 50 firm — w godzinę zamiast tygodnia. CRM dziękuje.' },
  { role: 'Finanse & Księgowość', insight: 'Streszczasz raporty i analizujesz pliki Excel głosem zwykłym. Nie kuglujesz formuł — pytasz.' },
  { role: 'Marketing & Treść', insight: 'Briefy, posty, scenariusze — szybciej. Ale co najważniejsze: w Twoim głosie marki, nie w głosie ChatGPT.' },
  { role: 'Asystent zarządu', insight: 'Streszczenia spotkań z cytowaniami, prezentacje z briefu jednym akapitem, korespondencja z trzech języków.' },
  { role: 'Mikroprzedsiębiorca / JDG', insight: 'Robisz pracę 3 osób — bez 3 osób. AI to twój zespół, którego dotąd nie miałeś.' },
];

---

<BaseLayout
  title="Next Mind Academy — szkolenia AI dla pracowników biurowych | dofinansowanie do 90%"
  description={SITE.description}
  hideHeaderBorder={true}
>
  <!-- ====================================================
       S1 — HERO
       Editorial display headline, asymmetric grid, sticky meta
       ==================================================== -->
  <section class="hero relative overflow-hidden">
    <!-- Decorative background composition -->
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-glow"></div>
      <svg class="hero-arc" viewBox="0 0 800 800" fill="none">
        <circle cx="400" cy="400" r="320" stroke="#0A1530" stroke-width="0.5" stroke-dasharray="2 6" opacity="0.12" />
        <circle cx="400" cy="400" r="240" stroke="#0A1530" stroke-width="0.5" opacity="0.12" />
        <circle cx="400" cy="400" r="160" stroke="#2D5BFF" stroke-width="0.7" opacity="0.35" />
      </svg>
    </div>

    <div class="container-edge relative pt-12 lg:pt-20 pb-16 lg:pb-32">
      <!-- Top meta bar -->
      <div class="flex items-center gap-3 text-[0.78rem] font-mono text-[var(--color-ink-4)] mb-10 reveal reveal-1">
        <span class="tabular-nums">N<span class="text-[var(--color-accent)]">/</span>01</span>
        <span class="rule-dotted flex-1 max-w-[6rem]"></span>
        <span class="uppercase tracking-[0.18em] text-[0.7rem] font-semibold">Akademia AI · Edycja 2026</span>
      </div>

      <div class="grid lg:grid-cols-12 gap-x-8 gap-y-12 items-end">
        <!-- Headline — column 1-9 -->
        <div class="lg:col-span-9 reveal reveal-2">
          <h1 class="hero-h1">
            Naucz się <span class="display-italic">AI w pracy biurowej</span>.<br class="hidden lg:inline" />
            <span class="hero-h1-row">
              W <span class="big-number-inline">jeden</span> dzień. Z dofinansowaniem do <span class="hero-pct">90%</span>.
            </span>
          </h1>

          <p class="lead mt-8 max-w-3xl reveal reveal-3">
            Praktyczne szkolenia z <strong class="font-medium text-[var(--color-ink)]">ChatGPT, Gemini, Claude i NotebookLM</strong>
            dla pracowników spoza IT.
            Online live, kameralna grupa <span class="marker-orange">4–10 osób</span>, zaświadczenie z mapowaniem efektów na ramę DigComp 2.2.
          </p>

          <div class="mt-10 flex flex-wrap gap-3 reveal reveal-4">
            <a href="#szkolenia" class="btn btn-primary btn-lg">
              Zobacz szkolenia
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M13 8L8 3M13 8L8 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>

          <!-- Selektor grupy — wejście do analizatora ścieżki finansowania -->
          <div class="picker mt-12 reveal reveal-4">
            <h2 class="picker-q">Kim jesteś? Sprawdź, gdzie złożyć wniosek.</h2>
            <div class="picker-grid">
              {AUDIENCES.map((a) => (
                <a href={`/dofinansowanie/kalkulator/?kim=${a.value}`} class="picker-card">
                  <span class="picker-label">{a.label}</span>
                  <span class="picker-hint">{a.hint}</span>
                  <span class="picker-go" aria-hidden="true">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 16 16" fill="none">
                      <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
            <p class="picker-note">
              Pułap zależy od tego, kto wnioskuje: <strong>do 90%</strong> dla firm do 9 osób i podmiotów
              bez pracowników, <strong>do 70%</strong> dla większych. Osoby prywatne mają odrębne ścieżki.
            </p>
          </div>
        </div>

        <!-- Side card — column 10-12 -->
        <aside class="lg:col-span-3 reveal reveal-5">
          <div class="hero-card">
            <div class="eyebrow !text-[var(--color-accent)] mb-3">Najbliższa edycja</div>
            <div class="text-[2.75rem] leading-[1] font-display tracking-tight text-[var(--color-ink)]">
              {nearestParts ? nearestParts.day : '—'}
              <span class="text-[var(--color-accent)] display-italic text-[1.75rem] align-top">
                {nearestParts ? `.${nearestParts.month}` : ''}
              </span>
            </div>
            <div class="text-[0.78rem] uppercase tracking-[0.16em] text-[var(--color-ink-4)] mt-1 font-mono">
              {nearestParts ? `${nearestParts.year} · ${nearestParts.weekday}` : 'termin w ustalaniu'}
            </div>
            <div class="rule-dotted my-4"></div>
            <p class="text-sm text-[var(--color-ink-2)] leading-snug">
              <span class="display-italic text-[var(--color-ink)]">{nearestCourse?.data.eyebrow.split('•')[0].trim()}</span>
              <br />Online live, 9:00–16:00.
            </p>
            <div class="mt-3 flex items-center gap-2 text-[0.78rem]">
              <span class="inline-block w-1.5 h-1.5 rounded-full bg-[var(--color-warn)]"></span>
              <span class="text-[var(--color-ink-3)]"><strong class="text-[var(--color-ink)] font-medium">{nearestEdition?.data.seatsAvailable}</strong> z {nearestEdition?.data.seatsTotal} miejsc</span>
            </div>
            <a href={nearestCourse ? `/szkolenia/${nearestCourse.data.slug}/` : '/szkolenia/'} class="mt-5 inline-flex items-center gap-1.5 text-sm text-[var(--color-ink)] hover:text-[var(--color-accent)] transition-colors group">
              <span class="border-b border-[var(--color-accent)] pb-0.5">Zobacz program</span>
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" viewBox="0 0 16 16" fill="none">
                <path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </div>
        </aside>
      </div>

      <!-- Trust strip — bottom of hero -->
      <div class="hero-trust mt-16 lg:mt-24 reveal reveal-6">
        <div class="rule-line mb-6"></div>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-5">
          {TRUST_SIGNALS.map((signal, i) => (
            <div class="trust-item">
              <span class="trust-no">{String(i + 1).padStart(2, '0')}</span>
              <span class="trust-label">{signal.label}</span>
              <span class="trust-detail">{signal.detail}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ====================================================
       S2 — MARQUEE / Tools
       ==================================================== -->
  <section class="marquee-section py-8 border-y border-[var(--color-rule)] bg-[var(--color-paper-soft)]">
    <div class="marquee">
      <div class="marquee-track">
        {[...Array(2)].map(() => (
          <>
            <span class="marquee-item">ChatGPT</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Gemini</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Claude</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">NotebookLM</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Microsoft Copilot</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Custom GPT</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Gemini Gem</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Claude Projects</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Zapier</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Perplexity</span>
            <span class="marquee-dot">●</span>
            <span class="marquee-item">Gamma</span>
            <span class="marquee-dot">●</span>
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================
       S3 — Cost-logic strip (USP #1: price)
       Editorial financial moment
       ==================================================== -->
  <Section surface="paper" padding="default">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <div class="flex items-center gap-3 mb-3">
          <span class="section-counter">02</span>
          <span class="rule-dotted flex-1 max-w-[3rem]"></span>
          <span class="eyebrow eyebrow--centered">Logika kosztu</span>
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-[3.5rem] leading-[1.02] tracking-tight">
          Cena rynkowa <span class="display-italic text-[var(--color-ink-4)]">jest tylko</span> ceną&nbsp;rynkową.
        </h2>
        <p class="mt-6 text-[var(--color-ink-3)] leading-relaxed">
          Większość pracowników biurowych w Polsce ma prawo do dofinansowania szkoleń w 80–90%.
          Z KFS albo z programu regionalnego w swoim województwie. Po prostu — większość o tym nie wie.
        </p>
        <a href="/dofinansowanie/kalkulator/" class="mt-8 inline-flex items-center gap-2 group">
          <span class="btn btn-primary">Sprawdź swoje dofinansowanie</span>
        </a>
      </div>

      <div class="lg:col-span-7">
        <div class="cost-card">
          <div class="cost-header">
            <span class="eyebrow !text-[var(--color-paper)] opacity-70">Szkolenie 1-dniowe — Basic</span>
            <span class="text-[var(--color-marker)] text-xs font-mono">{nearestDate ? `edycja ${formatEditionNumeric(nearestDate)}` : 'termin w ustalaniu'}</span>
          </div>

          <div class="cost-row">
            <span class="cost-label">Cena katalogowa netto</span>
            <span class="cost-value cost-strike">{formatPrice(1490)}</span>
          </div>
          <div class="cost-row">
            <span class="cost-label">Z dofinansowaniem regionalnym</span>
            <span class="cost-value">{formatPrice(298)}</span>
          </div>
          <div class="cost-row cost-row-final">
            <span class="cost-label-final">
              <span class="display-italic text-[var(--color-marker)]">Z KFS Priorytet 3</span> — mikroprzedsiębiorca, 90%
            </span>
            <span class="cost-value-final">{formatPrice(149)}</span>
          </div>

          <p class="mt-6 text-[0.72rem] text-[var(--color-paper)] opacity-50 leading-relaxed">
            Disclaimer: dofinansowanie zależy od województwa, statusu firmy i priorytetu. Sprawdź indywidualnie.
            Stan prawny na 30.04.2026.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- ====================================================
       S4 — THREE COURSES
       ==================================================== -->
  <Section surface="paper-soft" padding="default" id="szkolenia">
    <div class="section-header">
      <div class="flex items-center gap-3">
        <span class="section-counter">03</span>
        <span class="rule-dotted flex-1 max-w-[3rem]"></span>
        <span class="eyebrow eyebrow--centered">Program edukacyjny</span>
      </div>
      <div class="grid md:grid-cols-12 gap-x-8 items-end">
        <h2 class="md:col-span-7 text-4xl md:text-5xl lg:text-[3.75rem] leading-[1.02] tracking-tight">
          Trzy poziomy. Jedna <span class="display-italic">droga</span>.
        </h2>
        <p class="md:col-span-5 lead text-[var(--color-ink-3)] mt-6 md:mt-0">
          Od pierwszego promptu do własnego asystenta zintegrowanego z Twoim arkuszem.
          Każdy krok ma swój moment, swój rytuał, swoje zadanie do wykonania w realnej pracy.
        </p>
      </div>
    </div>

    <div class="grid lg:grid-cols-3 gap-5">
      {courses.map((course, i) => {
        const ed = upcomingByCourse[course.data.slug];
        return (
          <CourseCard
            slug={course.data.slug}
            title={course.data.title}
            eyebrow={course.data.eyebrow}
            summary={course.data.summary}
            durationLabel={course.data.durationLabel}
            level={course.data.level}
            levelLabel={course.data.levelLabel}
            priceNet={course.data.priceNet}
            priceWithKfs={course.data.priceWithKfs}
            nextEditionLabel={ed ? formatDateShort(ed.data.date) : undefined}
            keyTools={course.data.keyTools}
            index={i}
          />
        );
      })}
      <!-- Program 100h placeholder card -->
      <CourseCard
        slug="ai-w-pracy-biurowej-program-100h"
        title="Program 100h"
        eyebrow="Program rozwojowy • Q3 2026"
        summary="Pełna transformacja zawodowa. 100h w 12 tyg. Dla osób, które chcą zrobić z AI swój zawód."
        durationLabel="100h / 12 tyg."
        level="zaawansowany"
        levelLabel="Zaawansowany"
        priceNet={0}
        keyTools={["Custom GPT", "Claude API", "Make", "n8n", "AI Studio"]}
        upcoming={true}
        index={2}
      />
    </div>
  </Section>

  <!-- ====================================================
       S5 — DLA KOGO (personas)
       ==================================================== -->
  <Section surface="paper" padding="default">
    <div class="section-header">
      <div class="flex items-center gap-3">
        <span class="section-counter">04</span>
        <span class="rule-dotted flex-1 max-w-[3rem]"></span>
        <span class="eyebrow eyebrow--centered">Dla kogo</span>
      </div>
      <div class="grid md:grid-cols-12 gap-x-8 items-end">
        <h2 class="md:col-span-7 text-4xl md:text-5xl lg:text-[3.75rem] leading-[1.02] tracking-tight">
          Sześć ról. Każda z innym <span class="display-italic">"a co mi z tego"</span>.
        </h2>
        <p class="md:col-span-5 lead text-[var(--color-ink-3)] mt-6 md:mt-0">
          Nie sprzedajemy „transformacji". Pokazujemy konkretne zastosowania dla Twojej roli — nie roli abstrakcyjnego pracownika.
        </p>
      </div>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-[var(--color-rule)] border border-[var(--color-rule)] rounded-lg overflow-hidden">
      {personas.map((p, i) => (
        <article class="persona-card">
          <div class="flex items-baseline justify-between mb-4">
            <span class="font-mono text-[0.7rem] text-[var(--color-ink-4)] tabular-nums">{String(i + 1).padStart(2, '0')}</span>
            <span class="display-italic text-2xl text-[var(--color-accent)]">{p.role.split(' ')[0]}</span>
          </div>
          <h3 class="font-display text-[1.625rem] tracking-tight leading-[1.1] mb-3">
            {p.role}
          </h3>
          <p class="text-[0.95rem] text-[var(--color-ink-3)] leading-relaxed">
            {p.insight}
          </p>
        </article>
      ))}
    </div>
  </Section>

  <!-- ====================================================
       S6 — TRENER (editorial portrait moment)
       ==================================================== -->
  <Section surface="card" padding="default" class="border-y border-[var(--color-rule)]">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-5">
        <div class="trainer-portrait">
          <div class="trainer-portrait-frame">
            <!-- Portrait placeholder — geometric editorial -->
            <svg viewBox="0 0 400 480" class="w-full h-auto" aria-hidden="true">
              <rect width="400" height="480" fill="#ECF0F7" />
              <circle cx="200" cy="180" r="80" fill="#0A1530" />
              <circle cx="200" cy="180" r="80" fill="url(#portrait-grain)" opacity="0.5" />
              <path d="M80 480 Q80 320 200 320 Q320 320 320 480 Z" fill="#0A1530" />
              <rect x="0" y="0" width="400" height="6" fill="#2D5BFF" />
              <text x="40" y="465" font-family="Geist Mono, monospace" font-size="11" fill="#0A1530" opacity="0.5">PRZEMEK NOWAK · 2026</text>
              <defs>
                <pattern id="portrait-grain" patternUnits="userSpaceOnUse" width="4" height="4">
                  <circle cx="2" cy="2" r="0.4" fill="#2D5BFF" opacity="0.4" />
                </pattern>
              </defs>
            </svg>
            <div class="trainer-portrait-marker">
              <div class="text-[0.65rem] uppercase tracking-[0.18em] text-[var(--color-ink-4)] font-mono">Trener wiodący</div>
              <div class="font-display font-bold text-2xl text-[var(--color-ink)] mt-0.5">Przemek Nowak</div>
            </div>
          </div>
        </div>
      </div>

      <div class="lg:col-span-7">
        <div class="flex items-center gap-3 mb-3">
          <span class="section-counter">05</span>
          <span class="rule-dotted flex-1 max-w-[3rem]"></span>
          <span class="eyebrow eyebrow--centered">Kto prowadzi</span>
        </div>
        <h2 class="text-4xl md:text-5xl lg:text-[3.5rem] leading-[1.05] tracking-tight">
          „Najlepszy prompt napisał ktoś, kto rozumie&nbsp;<span class="display-italic">problem</span>.
          Nie ten, kto rozumie modele."
        </h2>
        <p class="mt-6 text-[var(--color-ink-3)] leading-relaxed max-w-2xl">
          {trainer?.data.shortBio}
        </p>

        <dl class="mt-10 grid grid-cols-3 gap-6 max-w-2xl">
          <div>
            <dt class="eyebrow eyebrow--centered !text-[var(--color-ink-4)] mb-2">Lat doświadczenia</dt>
            <dd class="big-number">{trainer?.data.yearsOfExperience}</dd>
          </div>
          <div>
            <dt class="eyebrow eyebrow--centered !text-[var(--color-ink-4)] mb-2">Godzin szkoleń</dt>
            <dd class="big-number">{trainer?.data.hoursDelivered}</dd>
          </div>
          <div>
            <dt class="eyebrow eyebrow--centered !text-[var(--color-ink-4)] mb-2">Uczestników</dt>
            <dd class="big-number">{trainer?.data.participantsTrained}</dd>
          </div>
        </dl>

        <div class="mt-10 flex flex-wrap gap-3">
          <a href="/trener/" class="btn btn-secondary">Pełen profil trenera</a>
          <a href={trainer?.data.linkedin} target="_blank" rel="noopener" class="btn btn-ghost">
            LinkedIn
            <svg class="w-3.5 h-3.5" viewBox="0 0 12 12" fill="none">
              <path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </Section>

  <!-- ====================================================
       S7 — DOFINANSOWANIE (timeline)
       ==================================================== -->
  <Section surface="paper" padding="default">
    <div class="section-header">
      <div class="flex items-center gap-3">
        <span class="section-counter">06</span>
        <span class="rule-dotted flex-1 max-w-[3rem]"></span>
        <span class="eyebrow eyebrow--centered">Mechanika dofinansowania</span>
      </div>
      <div class="grid md:grid-cols-12 gap-x-8 items-end">
        <h2 class="md:col-span-7 text-4xl md:text-5xl lg:text-[3.75rem] leading-[1.02] tracking-tight">
          Trzy kroki do <span class="display-italic">płacenia</span> dziesiątej części.
        </h2>
        <p class="md:col-span-5 lead text-[var(--color-ink-3)] mt-6 md:mt-0">
          BUR brzmi urzędowo, ale w praktyce to formularz na 15 minut. Pomożemy go wypełnić.
        </p>
      </div>
    </div>

    <ol class="timeline">
      <li class="timeline-step">
        <div class="timeline-marker"><span>1</span></div>
        <div class="timeline-content">
          <h3 class="timeline-title">Wybierasz szkolenie</h3>
          <p class="timeline-desc">Klikasz „Zobacz program", czytasz, wybierasz konkretną edycję. Nasze szkolenia są wpisane do BUR — to warunek formalny dofinansowania.</p>
          <span class="timeline-time">~5 min</span>
        </div>
      </li>

      <li class="timeline-step">
        <div class="timeline-marker"><span>2</span></div>
        <div class="timeline-content">
          <h3 class="timeline-title">Składasz wniosek u operatora</h3>
          <p class="timeline-desc">Program regionalny albo KFS przez urząd pracy. Pomożemy skompletować dokumenty i napisać uzasadnienie — to najczęstszy powód zwrotu wniosku.</p>
          <span class="timeline-time">2–4 tygodnie na decyzję</span>
        </div>
      </li>

      <li class="timeline-step">
        <div class="timeline-marker"><span>3</span></div>
        <div class="timeline-content">
          <h3 class="timeline-title">Bierzesz udział i&nbsp;płacisz tylko swój wkład</h3>
