---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
---

<BaseLayout
  title="Checklista bezpieczeństwa RODO dla pracy z AI — bezpłatny PDF"
  description="10 punktów: czego nie wklejać do AI, jak anonimizować, jak konfigurować ustawienia danych. PDF do wydruku."
  noindex={true}
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[{ name: 'Strona główna', url: '/' }, { name: 'Materiały' }, { name: 'Checklista RODO' }]} />
  </div>

  <Section padding="default">
    <div class="grid lg:grid-cols-12 gap-12 items-center">
      <div class="lg:col-span-7">
        <div class="eyebrow !text-[var(--color-accent)]">Bezpłatny PDF</div>
        <h1 class="mt-5 text-4xl md:text-5xl lg:text-[4.5rem] leading-[0.98] tracking-tight">
          Checklista <span class="display-italic">RODO</span> dla&nbsp;pracy z&nbsp;AI.
        </h1>
        <p class="lead mt-7 text-[var(--color-ink-3)] max-w-2xl">
          Dziesięć punktów: czego nigdy nie wklejać, jak anonimizować dokumenty, jak skonfigurować ustawienia prywatności w&nbsp;ChatGPT, Gemini i&nbsp;Claude.
          Do druku, na biurko, obok klawiatury.
        </p>

        <ul class="mt-8 space-y-2">
          {[
            'Format A4, 1 strona, do druku',
            'Zgodne z RODO i Ustawą o ochronie danych osobowych 2018 r.',
            'Sekcje: dane osobowe, poufne, finansowe, medyczne, prawne',
            'Konkretne instrukcje konfiguracji każdego narzędzia',
          ].map((p) => (
            <li class="flex items-start gap-2.5 text-[0.95rem]">
              <span class="text-[var(--color-accent)] mt-1">▸</span>
              <span class="text-[var(--color-ink-2)]">{p}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-5">
        <div class="lead-magnet-form">
          <span class="eyebrow !text-[var(--color-accent)]">Zostaw e-mail — wyślemy PDF</span>
          <form method="POST" action="/api/material/" class="mt-5 space-y-3" data-form="lead-magnet">
            <input type="hidden" name="material" value="checklista-rodo-ai" />
            <label class="sr-only" for="lm-email">E-mail</label>
            <input id="lm-email" name="email" type="email" required placeholder="twój@e-mail.pl" class="field-input" />
            <label class="flex items-start gap-2 text-[0.78rem] text-[var(--color-ink-4)] leading-relaxed">
              <input type="checkbox" name="newsletter" class="mt-0.5 accent-[var(--color-accent)]" />
              <span>Chcę dostawać newsletter NMA (opcjonalnie).</span>
            </label>
            <label class="flex items-start gap-2 text-[0.78rem] text-[var(--color-ink-4)] leading-relaxed">
              <input type="checkbox" name="rodo" required class="mt-0.5 accent-[var(--color-accent)]" />
              <span>Zgoda na przetwarzanie e-maila (RODO). <a href="/polityka-prywatnosci/" class="ink-link">Polityka prywatności</a>.</span>
            </label>
            <button type="submit" class="btn btn-accent w-full">Pobierz checklistę</button>
          </form>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .lead-magnet-form {
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 12px;
    padding: 2rem;
    box-shadow: 0 24px 50px -28px rgba(21, 17, 13, 0.18);
    position: relative;
  }
  .lead-magnet-form::before {
    content: '';
    position: absolute;
    top: 0; left: 1.5rem; right: 1.5rem;
    height: 4px;
    background: linear-gradient(to right, var(--color-accent), var(--color-marker));
  }
</style>
