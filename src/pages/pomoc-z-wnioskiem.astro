---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { OPERATOR } from '../lib/site';

const steps = [
  {
    t: 'Ustalamy ścieżkę',
    d: 'Na 20-minutowej rozmowie sprawdzamy, czy w Twoim przypadku właściwy jest KFS, czy program regionalny. To rozstrzyga się na początku i przesądza o całej reszcie.',
  },
  {
    t: 'Sprawdzamy terminy naboru',
    d: 'Nabory ogłaszają powiatowe urzędy pracy i operatorzy regionalni, każdy we własnym rytmie. Pilnujemy, żeby nie okazało się, że nabór zamknął się tydzień wcześniej.',
  },
  {
    t: 'Kompletujemy dokumenty',
    d: 'Karta usługi z BUR, program szkolenia, dane do wniosku, dokumenty dotyczące pomocy de minimis. Wysyłamy komplet w jednym mailu.',
  },
  {
    t: 'Pomagamy napisać uzasadnienie',
    d: 'To najczęstszy powód odrzucenia. Piszemy je razem, wiążąc szkolenie z konkretnym stanowiskiem i zmianą w firmie — zamiast ogólników o rozwoju.',
  },
  {
    t: 'Jesteśmy przy rozliczeniu',
    d: 'Po szkoleniu wystawiamy dokumenty w formie wymaganej przez urząd lub operatora i przypominamy o ocenie usługi w BUR, bez której wstrzymywane bywa rozliczenie.',
  },
];

const honest = [
  {
    t: 'Nie składamy wniosku za Ciebie',
    d: 'Wniosek do KFS składa pracodawca ze swojego konta na praca.gov.pl, podpisując go profilem zaufanym lub podpisem kwalifikowanym. Możemy przygotować treść i być na linii, ale podpis i wysyłka są po Twojej stronie.',
  },
  {
    t: 'Nie obiecujemy decyzji pozytywnej',
    d: 'Decyzja należy do urzędu lub operatora i zależy też od budżetu, który bywa wyczerpywany w trakcie naboru. Każdy, kto gwarantuje dofinansowanie, mija się z prawdą.',
  },
  {
    t: 'Nie pobieramy za to opłaty',
    d: 'Pomoc jest bezpłatna dla osób i firm, które kupują u nas szkolenie. Nie prowadzimy odpłatnego doradztwa dotacyjnego.',
  },
];
---

<BaseLayout
  title="Pomoc w przygotowaniu wniosku o dofinansowanie — KFS i programy regionalne"
  description="Przygotowujemy z Tobą wniosek o dofinansowanie szkolenia z KFS lub programu regionalnego. Bezpłatnie dla uczestników naszych szkoleń."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Pomoc z wnioskiem' },
    ]} />
  </div>

  <Section padding="default">
    <div class="grid lg:grid-cols-12 gap-12 items-end">
      <div class="lg:col-span-8">
        <div class="eyebrow">Wsparcie dla uczestników</div>
        <h1 class="mt-5 text-5xl md:text-6xl lg:text-[5rem] leading-[0.97] tracking-tight">
          Wniosek przygotujemy <span class="display-italic">razem</span>.
        </h1>
        <p class="lead mt-7 text-[var(--color-ink-3)] max-w-2xl">
          Formalności zniechęcają skuteczniej niż cena. Jeśli szkolisz się u nas, przechodzimy przez nie
          z Tobą — od ustalenia właściwej ścieżki po rozliczenie. Bezpłatnie.
        </p>
      </div>
      <div class="lg:col-span-4">
        <a href="/kontakt/" class="btn btn-primary btn-lg w-full">Umów rozmowę</a>
        <a href="/dofinansowanie/kalkulator/" class="btn btn-ghost btn-lg w-full mt-3">
          Najpierw sprawdź ścieżkę
        </a>
      </div>
    </div>
  </Section>

  <Section surface="paper-soft" padding="default" counter="01" eyebrow="Jak pomagamy">
    <h2 class="mt-6 text-3xl md:text-4xl tracking-tight leading-tight max-w-3xl">
      Pięć etapów, przy których <span class="display-italic">jesteśmy</span>.
    </h2>
    <ol class="mt-10 space-y-6 max-w-4xl">
      {steps.map((s, i) => (
        <li class="flex items-start gap-5">
          <span class="font-display italic text-3xl text-[var(--color-accent)] leading-none shrink-0 pt-1">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <h3 class="font-display text-xl tracking-tight text-[var(--color-ink)]">{s.t}</h3>
            <p class="mt-1.5 text-[var(--color-ink-3)] leading-relaxed">{s.d}</p>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <Section padding="default" counter="02" eyebrow="Warunek">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-6">
        <h2 class="text-3xl md:text-4xl tracking-tight leading-tight">
          Dla kogo to <span class="display-italic">bezpłatne</span>.
        </h2>
        <p class="mt-5 text-[var(--color-ink-3)] leading-relaxed">
          Pomoc przysługuje osobom i firmom, które kupują u nas szkolenie. Nie jest to osobna usługa
          doradcza — traktujemy ją jako część procesu zapisu, bo bez skutecznego wniosku i tak nie
          doszłoby do szkolenia.
        </p>
        <p class="mt-4 text-[var(--color-ink-3)] leading-relaxed">
          Jesteśmy wpisani do Bazy Usług Rozwojowych, co od 2026 r. jest warunkiem formalnym
          finansowania szkolenia z KFS i podstawą rozliczenia w programach regionalnych.
        </p>
        <a
          href={OPERATOR.burProviderUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 mt-6 text-sm font-medium text-[var(--color-accent-deep)] underline underline-offset-4"
        >
          Nasz profil w BUR
          <svg class="w-3 h-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 9L9 3M9 3H4M9 3V8" stroke="currentColor" stroke-width="1.2" />
          </svg>
        </a>
      </div>

      <div class="lg:col-span-6">
        <div class="eyebrow !text-[var(--color-ink-4)] mb-4">Czego nie robimy</div>
        <ul class="space-y-3">
          {honest.map((h) => (
            <li class="bg-[var(--color-card-raised)] border border-[var(--color-rule)] rounded-md p-5">
              <h3 class="font-medium text-[var(--color-ink)]">{h.t}</h3>
              <p class="mt-1.5 text-sm text-[var(--color-ink-3)] leading-relaxed">{h.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  <section class="surface-night">
    <div class="container-edge py-20 md:py-28">
      <h2 class="text-4xl md:text-5xl text-[var(--color-paper)] tracking-tight leading-tight max-w-3xl">
        Zacznij od <span class="display-italic text-[var(--color-marker)]">jednej rozmowy</span>.
      </h2>
      <p class="mt-5 text-lg text-white/70 max-w-2xl">
        Dwadzieścia minut wystarczy, żeby ustalić, czy w Twoim przypadku właściwy jest KFS,
        czy program regionalny — i czy w ogóle warto składać wniosek w tym momencie.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/kontakt/" class="btn btn-accent btn-lg">Umów rozmowę</a>
        <a href="/terminy/" class="btn btn-ghost btn-lg !border-white/20 !text-[var(--color-paper)] hover:!bg-white/5">
          Zobacz najbliższe terminy
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
