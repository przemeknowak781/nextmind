---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { formatPrice } from '../../lib/format';
import {
  getCatalog,
  plainDate,
  isRecruitmentOpen,
  dayHours,
  BUR_FETCHED_AT,
  type Offering,
} from '../../lib/bur';

// Strony szkoleń generujemy z katalogu w Bazie Usług Rozwojowych. Program,
// ceny i terminy pochodzą z karty usługi — nie z osobno utrzymywanego opisu,
// który mógłby się z nią rozjechać.
export function getStaticPaths() {
  return getCatalog().map((offering) => ({
    params: { slug: offering.slug },
    props: { offering },
  }));
}

interface Props {
  offering: Offering;
}
const { offering } = Astro.props;

const openTerms = offering.terms.filter((t) => isRecruitmentOpen(t));
const nextTerm = openTerms[0] ?? offering.terms[0];
const hours = nextTerm ? dayHours(nextTerm) : null;

// Program pokazujemy na podstawie harmonogramu najbliższego terminu.
const agenda = (nextTerm?.schedule ?? []).filter((h) => h.type !== 'PRZERWA' && h.topic);

const fetchedLabel = BUR_FETCHED_AT
  ? new Date(BUR_FETCHED_AT).toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' })
  : null;

function longDate(iso: string | null) {
  return (
    plainDate(iso)?.toLocaleDateString('pl-PL', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }) ?? ''
  );
}
function shortDate(iso: string | null) {
  return (
    plainDate(iso)?.toLocaleDateString('pl-PL', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      timeZone: 'UTC',
    }) ?? ''
  );
}
/** Grupuje agendę po dniach — przy szkoleniach wielodniowych to czytelniejsze. */
const byDay = new Map<string, typeof agenda>();
for (const item of agenda) {
  const key = item.date?.slice(0, 10) ?? '';
  if (!byDay.has(key)) byDay.set(key, []);
  byDay.get(key)!.push(item);
}
const agendaDays = [...byDay.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout
  title={`${offering.title.slice(0, 65)} | Next Mind Academy`}
  description={`${offering.title.slice(0, 120)}. ${offering.priceNet ? `Cena ${offering.priceNet} zł netto. ` : ''}Szkolenie w Bazie Usług Rozwojowych — możliwe rozliczenie z dofinansowania.`}
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Szkolenia', url: '/szkolenia/' },
      { name: offering.title.slice(0, 40) + (offering.title.length > 40 ? '…' : '') },
    ]} />
  </div>

  <Section padding="default">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-8">
        <div class="eyebrow">Szkolenie</div>
        <h1 class="mt-5 text-3xl md:text-4xl lg:text-[2.85rem] leading-[1.12] tracking-tight">
          {offering.title}
        </h1>

        <dl class="facts">
          {offering.days > 0 && (
            <div><dt>Czas trwania</dt><dd>{offering.days === 1 ? '1 dzień' : `${offering.days} dni`}</dd></div>
          )}
          {offering.hours && <div><dt>Liczba godzin</dt><dd>{offering.hours} h</dd></div>}
          {hours && <div><dt>Godziny zajęć</dt><dd>{hours.from}–{hours.to}</dd></div>}
          {offering.seatsMin && offering.seatsMax && (
            <div><dt>Wielkość grupy</dt><dd>{offering.seatsMin}–{offering.seatsMax} osób</dd></div>
          )}
          <div><dt>Liczba terminów</dt><dd>{offering.terms.length}</dd></div>
        </dl>
      </div>

      <aside class="lg:col-span-4">
        <div class="buy">
          {offering.priceNet !== null && (
            <>
              <div class="buy-price">{formatPrice(offering.priceNet)}</div>
              <div class="buy-price-lbl">netto za uczestnika</div>
              {offering.priceGross !== null && (
                <div class="buy-gross">{formatPrice(offering.priceGross)} brutto</div>
              )}
            </>
          )}

          {nextTerm && (
            <>
              <div class="buy-rule"></div>
              <div class="buy-next-lbl">
                {openTerms.length > 0 ? 'Najbliższy termin z zapisami' : 'Najbliższy termin'}
              </div>
              <div class="buy-next">{longDate(nextTerm.startDate)}</div>
              <a
                href={nextTerm.url}
                target="_blank"
                rel="noopener"
                class={`btn btn-lg w-full mt-4 ${openTerms.length > 0 ? 'btn-primary' : 'btn-ghost'}`}
              >
                {openTerms.length > 0 ? 'Zapisz się przez BUR' : 'Zobacz w BUR'}
              </a>
            </>
          )}

          <a href="/dofinansowanie/kalkulator/" class="btn btn-ghost w-full mt-2">
            Sprawdź dofinansowanie
          </a>
          <p class="buy-note">
            Szkolenie jest w Bazie Usług Rozwojowych, więc możesz rozliczyć je z KFS
            albo z programu regionalnego.
          </p>
        </div>
      </aside>
    </div>
  </Section>

  {agendaDays.length > 0 && (
    <Section surface="paper-soft" padding="default" counter="01" eyebrow="Program">
      <h2 class="mt-6 text-3xl md:text-4xl tracking-tight leading-tight max-w-3xl">
        Co dokładnie <span class="display-italic">robimy</span>.
      </h2>
      <p class="mt-4 text-sm text-[var(--color-ink-4)] max-w-3xl">
        Harmonogram najbliższego terminu, prosto z karty usługi w BUR.
      </p>

      <div class="mt-10 space-y-8 max-w-4xl">
        {agendaDays.map(([day, items], i) => (
          <div>
            {agendaDays.length > 1 && (
              <h3 class="agenda-day">Dzień {i + 1} — {shortDate(day)}</h3>
            )}
            <ol class="agenda">
              {items.map((item) => (
                <li class="agenda-item">
                  <span class="agenda-time">
                    {item.from?.slice(0, 5)}–{item.to?.slice(0, 5)}
                  </span>
                  <span class="agenda-topic">{item.topic}</span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
    </Section>
  )}

  <Section padding="default" counter="02" eyebrow="Terminy">
    <h2 class="mt-6 text-3xl md:text-4xl tracking-tight leading-tight max-w-3xl">
      Wszystkie <span class="display-italic">terminy</span> tego szkolenia.
    </h2>
    <ul class="terms mt-10">
      {offering.terms.map((t) => {
        const open = isRecruitmentOpen(t);
        return (
          <li class="term">
            <span class="term-date">{longDate(t.startDate)}</span>
            <span class="term-actions">
              {!open && <span class="term-closed">rekrutacja zamknięta</span>}
              <a
                href={t.url}
                target="_blank"
                rel="noopener"
                class={`btn btn-sm ${open ? 'btn-primary' : 'btn-ghost'}`}
              >
                {open ? 'Zapisz się' : 'Zobacz w BUR'}
              </a>
            </span>
          </li>
        );
      })}
    </ul>
    <p class="mt-6 text-xs text-[var(--color-ink-4)]">
      Dane z profilu dostawcy w BUR{fetchedLabel && `, pobrane ${fetchedLabel}`}.
      Aktualną dostępność miejsc sprawdzisz na karcie usługi.
    </p>
  </Section>
</BaseLayout>

<style>
  .facts {
    margin-top: 2rem;
    display: grid;
    gap: 1rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(9rem, max-content));
  }
  .facts dt {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-ink-4);
  }
  .facts dd {
    margin: 0.2rem 0 0;
    font-size: 1.05rem;
    color: var(--color-ink);
  }

  .buy {
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 10px;
    padding: 1.6rem;
  }
  .buy-price {
    font-family: var(--font-display);
    font-size: 2.25rem;
    line-height: 1;
    color: var(--color-ink);
  }
  .buy-price-lbl {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-4);
    margin-top: 0.35rem;
  }
  .buy-gross { font-size: 0.85rem; color: var(--color-ink-4); margin-top: 0.3rem; }
  .buy-rule { height: 1px; background: var(--color-rule); margin: 1.25rem 0; }
  .buy-next-lbl {
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-4);
  }
  .buy-next {
    margin-top: 0.25rem;
    font-weight: 500;
    color: var(--color-ink);
    text-transform: capitalize;
  }
  .buy-note {
    margin-top: 1rem;
    font-size: 0.78rem;
    line-height: 1.55;
    color: var(--color-ink-4);
  }

  .agenda-day {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--color-ink);
    margin-bottom: 0.75rem;
  }
  .agenda { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .agenda-item {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding: 0.7rem 0.9rem;
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 6px;
  }
  .agenda-time {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-ink-4);
    white-space: nowrap;
  }
  .agenda-topic { font-size: 0.9rem; color: var(--color-ink-2); line-height: 1.5; }

  .terms { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; max-width: 46rem; }
  .term {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.15rem;
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
  }
  .term-date { color: var(--color-ink); text-transform: capitalize; }
  .term-actions { display: flex; align-items: center; gap: 0.75rem; }
  .term-closed { font-size: 0.72rem; color: var(--color-ink-4); }
</style>
