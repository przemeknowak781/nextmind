---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';

---

<BaseLayout
  title="Program 100h — pełna transformacja zawodowa AI | Q3 2026"
  description="100 godzin dydaktycznych w 12 tygodni. Najgłębszy program rozwojowy NMA — startujemy w Q3 2026. Zostaw kontakt na liście oczekujących."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Szkolenia', url: '/szkolenia/' },
      { name: 'Program 100h' },
    ]} />
  </div>

  <Section padding="default">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-7">
        <div class="eyebrow">Program rozwojowy • Q3 2026</div>
        <h1 class="mt-5 text-5xl md:text-6xl lg:text-[5.5rem] leading-[0.96] tracking-tight">
          Sto godzin. <span class="display-italic">Dwanaście tygodni.</span>
          Inny zawód.
        </h1>
        <p class="lead mt-7 max-w-2xl">
          Program 100h to nie szkolenie. To trzymiesięczna ścieżka, która zmienia Cię z osoby
          „korzystającej z AI" w osobę, która wewnątrz organizacji <em class="display-italic">decyduje</em>, jak AI będzie używane.
        </p>

        <div class="mt-10 grid sm:grid-cols-2 gap-3 max-w-2xl">
          {[
            'Tygodniowe live\'y z trenerem (12 × 4h)',
            'Cotygodniowe ćwiczenia praktyczne',
            'Mentoring 1:1 (cztery sesje 60-min)',
            'Projekt końcowy — wdrożenie w Twojej firmie',
            'Społeczność — zamknięty Slack + meetupy',
            'Certyfikat z portfolio prac',
          ].map((m) => (
            <div class="flex items-start gap-2.5 text-[0.95rem]">
              <span class="text-[var(--color-accent)] mt-1">▸</span>
              <span class="text-[var(--color-ink-2)]">{m}</span>
            </div>
          ))}
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="program-card">
          <span class="eyebrow !text-[var(--color-accent)]">Lista oczekujących</span>
          <h2 class="mt-3 text-3xl font-display tracking-tight leading-tight">
            Pierwszy nabór: <span class="display-italic text-[var(--color-accent)]">Q3 2026</span>.
          </h2>
          <p class="mt-3 text-sm text-[var(--color-ink-3)]">
            Limity: 12 osób w grupie, jedna grupa na nabór. Pierwszeństwo dla osób z listy.
          </p>

          <form method="POST" action="/api/material/" class="mt-6 space-y-3" data-form="program-100h">
            <input type="hidden" name="formType" value="program-100h" />
            <label class="sr-only" for="p100-name">Imię</label>
            <input id="p100-name" name="name" type="text" required placeholder="Imię" class="field-input" />
            <label class="sr-only" for="p100-email">E-mail</label>
            <input id="p100-email" name="email" type="email" required placeholder="E-mail" class="field-input" />
            <label class="sr-only" for="p100-role">Stanowisko</label>
            <input id="p100-role" name="role" type="text" placeholder="Twoje stanowisko (opcjonalnie)" class="field-input" />
            <label class="flex items-start gap-2 text-[0.78rem] text-[var(--color-ink-4)] leading-relaxed">
              <input type="checkbox" name="rodo" required class="mt-0.5 accent-[var(--color-accent)]" />
              <span>Zgoda na przetwarzanie danych w celu poinformowania o starcie programu (RODO).</span>
            </label>
            <button type="submit" class="btn btn-primary w-full">Zapisz mnie na listę</button>
          </form>
        </div>
      </aside>
    </div>
  </Section>

  <Section surface="paper-soft" padding="default">
    <div class="eyebrow mb-3">Roadmapa programu</div>
    <h2 class="text-4xl md:text-5xl tracking-tight leading-tight max-w-3xl">
      Cztery moduły po cztery <span class="display-italic">tygodnie</span>.
    </h2>

    <div class="mt-12 grid md:grid-cols-2 lg:grid-cols-4 gap-px bg-[var(--color-rule)] border border-[var(--color-rule)] rounded-lg overflow-hidden">
      {[
        { m: 'M1', title: 'Fundamenty AI dla biura', focus: 'Prompty, narzędzia, RODO, etyka' },
        { m: 'M2', title: 'Asystenty i automatyzacja', focus: 'Custom GPT, Claude Project, Zapier' },
        { m: 'M3', title: 'Pipeline\'y i integracje', focus: 'API, n8n, Make, arkusze' },
        { m: 'M4', title: 'Wdrożenie i lider AI', focus: 'Projekt końcowy, change management' },
      ].map((m, i) => (
        <article class="bg-[var(--color-card-raised)] p-7">
          <span class="font-mono text-xs text-[var(--color-accent)] mb-4 block">{m.m}</span>
          <h3 class="font-display text-2xl tracking-tight leading-tight mb-2">{m.title}</h3>
          <p class="text-sm text-[var(--color-ink-3)]">{m.focus}</p>
          <div class="mt-6 text-xs text-[var(--color-ink-4)] font-mono uppercase tracking-wider">
            Tydzień {i * 3 + 1}–{i * 3 + 3}
          </div>
        </article>
      ))}
    </div>
  </Section>
</BaseLayout>

<style>
  .program-card {
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    padding: 2rem;
    border-radius: 8px;
    box-shadow: 0 24px 50px -32px rgba(21, 17, 13, 0.15);
    position: relative;
  }
  .program-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 1.5rem;
    right: 1.5rem;
    height: 3px;
    background: linear-gradient(to right, var(--color-accent), var(--color-marker));
  }
</style>
