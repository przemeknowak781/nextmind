---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import CourseCard from '../../components/courses/CourseCard.astro';
import { formatDateShort, formatPrice } from '../../lib/format';

const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const editions = await getCollection('editions');
const upcomingByCourse: Record<string, typeof editions[number] | undefined> = {};
const sortedEditions = [...editions].sort((a, b) => +a.data.date - +b.data.date);
for (const ed of sortedEditions) {
  if (!upcomingByCourse[ed.data.courseSlug] && ed.data.date >= new Date()) {
    upcomingByCourse[ed.data.courseSlug] = ed;
  }
}

const compareRows = [
  { label: 'Czas trwania', basic: '1 dzień (8h)', l2: '1 dzień (8h)', p100: '100h / 12 tyg.' },
  { label: 'Poziom', basic: 'Podstawowy', l2: 'Średniozaawansowany', p100: 'Zaawansowany' },
  { label: 'Główne narzędzia', basic: 'ChatGPT, Gemini, Claude, NotebookLM', l2: 'Custom GPT, Gem, Claude Project, Zapier', p100: 'API, Make, n8n, AI Studio' },
  { label: 'Cena netto', basic: formatPrice(1490), l2: formatPrice(1990), p100: 'Q3 2026' },
  { label: 'Z KFS Priorytet 3 (90%)', basic: formatPrice(149), l2: formatPrice(199), p100: 'do ustalenia' },
  { label: 'Certyfikat z DigComp 2.2', basic: 'Tak', l2: 'Tak', p100: 'Tak + portfolio' },
  { label: 'Walidacja', basic: 'Test + zadanie', l2: 'Test + projekt', p100: 'Projekt końcowy' },
];
---

<BaseLayout
  title="Szkolenia AI z dofinansowaniem | Basic, Level 2, Program 100h"
  description="Wybierz szkolenie AI dopasowane do Twojego poziomu. Online live, kameralna grupa, dofinansowanie z KFS i programów regionalnych. Sprawdź terminy."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Szkolenia' },
    ]} />
  </div>

  <Section padding="default" surface="paper">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-7">
        <div class="eyebrow">Katalog szkoleń</div>
        <h1 class="mt-5 text-5xl md:text-6xl lg:text-[5rem] leading-[0.98] tracking-tight">
          Szkolenia <span class="display-italic">AI</span> dla&nbsp;pracowników biurowych.
        </h1>
        <p class="lead mt-7 text-[var(--color-ink-2)] max-w-2xl">
          Trzy ścieżki rozwoju — od pierwszego promptu do własnego asystenta zintegrowanego z arkuszem.
          Każda z dofinansowaniem do 90% i certyfikatem zgodnym z DigComp 2.2.
        </p>
      </div>
      <div class="lg:col-span-5">
        <div class="rounded-md p-6 bg-[var(--color-card-raised)] border border-[var(--color-rule)]">
          <span class="eyebrow !text-[var(--color-accent)]">Nie wiesz, które wybrać?</span>
          <p class="mt-3 text-[var(--color-ink-2)] leading-relaxed">
            Trzy pytania prowadzą do rekomendacji. Quiz zajmuje 30 sekund.
          </p>
          <a href="#quiz" class="mt-4 btn btn-primary">Wykonaj szybki quiz</a>
        </div>
      </div>
    </div>
  </Section>

  <Section surface="paper-soft" padding="default">
    <h2 class="text-3xl md:text-4xl tracking-tight mb-10">Trzy ścieżki, jeden trener.</h2>
    <div class="grid lg:grid-cols-3 gap-5">
      {courses.map((course, i) => {
        const ed = upcomingByCourse[course.data.slug];
        return (
          <CourseCard
            slug={course.data.slug}
            title={course.data.title}
            eyebrow={course.data.eyebrow}
            summary={course.data.summary}
            durationLabel={course.data.durationLabel}
            level={course.data.level}
            levelLabel={course.data.levelLabel}
            priceNet={course.data.priceNet}
            priceWithKfs={course.data.priceWithKfs}
            nextEditionLabel={ed ? formatDateShort(ed.data.date) : undefined}
            keyTools={course.data.keyTools}
            index={i}
          />
        );
      })}
      <CourseCard
        slug="ai-w-pracy-biurowej-program-100h"
        title="Program 100h — pełna transformacja"
        eyebrow="Program rozwojowy • Online live + zadania"
        summary="100 godzin dydaktycznych w 12 tygodni. Dla osób, które chcą zrobić z AI swój zawód, nie hobby."
        durationLabel="100h / 12 tyg."
        level="zaawansowany"
        levelLabel="Zaawansowany"
        priceNet={0}
        keyTools={["Custom GPT", "Claude API", "Make", "n8n", "AI Studio"]}
        upcoming={true}
        index={2}
      />
    </div>
  </Section>

  <!-- Compare table -->
  <Section surface="paper" padding="default">
    <div class="grid md:grid-cols-12 gap-8 items-end mb-10">
      <h2 class="md:col-span-7 text-3xl md:text-4xl lg:text-[2.75rem] tracking-tight leading-tight">
        Porównanie <span class="display-italic">strona w stronę</span>.
      </h2>
      <p class="md:col-span-5 text-[var(--color-ink-3)]">
        Każda ścieżka ma swoje miejsce. Najczęściej rekomendujemy zaczynać od Basic — niezależnie od tego, ile lat pracujesz w korporacji.
      </p>
    </div>

    <div class="overflow-x-auto rounded-lg border border-[var(--color-rule)]">
      <table class="compare-table">
        <thead>
          <tr>
            <th></th>
            <th>Basic <span class="text-[var(--color-ink-4)] font-mono text-xs">1-day</span></th>
            <th>Level 2 <span class="text-[var(--color-ink-4)] font-mono text-xs">1-day</span></th>
            <th>Program <span class="text-[var(--color-ink-4)] font-mono text-xs">100h</span></th>
          </tr>
        </thead>
        <tbody>
          {compareRows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              <td>{row.basic}</td>
              <td>{row.l2}</td>
              <td class="text-[var(--color-ink-4)]">{row.p100}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Section>

  <!-- Mini quiz -->
  <Section id="quiz" surface="paper-soft" padding="default">
    <div class="grid lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5">
        <div class="eyebrow">Quiz: 3 pytania</div>
        <h2 class="mt-3 text-3xl md:text-4xl lg:text-[2.5rem] leading-tight tracking-tight">
          Które szkolenie <span class="display-italic">dla Ciebie</span>?
        </h2>
      </div>
      <div class="lg:col-span-7">
        <ol class="quiz-list">
          <li>
            <span class="quiz-num">01</span>
            <div>
              <h3 class="font-display text-2xl tracking-tight">Czy próbowałeś już ChatGPT lub Gemini?</h3>
              <p class="mt-2 text-[var(--color-ink-3)]">
                <strong>Nie</strong> lub <strong>tak, ale nie systematycznie</strong> → <a href="/szkolenia/ai-w-pracy-biurowej-podstawy/" class="ink-link">Basic</a>.<br />
                <strong>Tak, używam codziennie</strong> → idziesz dalej do pytania 2.
              </p>
            </div>
          </li>
          <li>
            <span class="quiz-num">02</span>
            <div>
              <h3 class="font-display text-2xl tracking-tight">Chcesz tworzyć własnych asystentów AI?</h3>
              <p class="mt-2 text-[var(--color-ink-3)]">
                <strong>Tak</strong> → <a href="/szkolenia/ai-w-pracy-biurowej-level-2/" class="ink-link">Level 2</a>.<br />
                <strong>Jeszcze nie</strong> → idziesz dalej do pytania 3.
              </p>
            </div>
          </li>
          <li>
            <span class="quiz-num">03</span>
            <div>
              <h3 class="font-display text-2xl tracking-tight">Ile czasu chcesz przeznaczyć?</h3>
              <p class="mt-2 text-[var(--color-ink-3)]">
                <strong>1 dzień</strong> → <a href="/szkolenia/ai-w-pracy-biurowej-podstawy/" class="ink-link">Basic</a> lub <a href="/szkolenia/ai-w-pracy-biurowej-level-2/" class="ink-link">Level 2</a>.<br />
                <strong>3 miesiące, na poważnie</strong> → <a href="/szkolenia/ai-w-pracy-biurowej-program-100h/" class="ink-link">Program 100h</a>.
              </p>
            </div>
          </li>
        </ol>

        <div class="mt-10 p-6 bg-[var(--color-card-raised)] border border-[var(--color-rule)] rounded-md">
          <p class="text-[var(--color-ink-2)]">
            <span class="display-italic text-2xl text-[var(--color-accent)]">Nadal niepewny?</span><br />
            Napisz na <a href="mailto:kontakt@nextmindacademy.pl" class="ink-link">kontakt@nextmindacademy.pl</a> — odpowiadamy w 24h.
          </p>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-card-raised);
  }
  .compare-table th, .compare-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid var(--color-rule);
    font-size: 0.92rem;
    text-align: left;
  }
  .compare-table thead th {
    background: var(--color-paper-deep);
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .compare-table thead th:first-child { background: transparent; }
  .compare-table tbody th {
    font-weight: 500;
    color: var(--color-ink-2);
    font-family: var(--font-sans);
    font-size: 0.85rem;
    background: var(--color-paper-soft);
    width: 22%;
  }
  .compare-table tr:last-child th, .compare-table tr:last-child td { border-bottom: none; }

  .quiz-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 2rem;
  }
  .quiz-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
  }
  .quiz-num {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 2.5rem;
    color: var(--color-accent);
    line-height: 1;
    align-self: flex-start;
    letter-spacing: -0.05em;
  }
</style>
