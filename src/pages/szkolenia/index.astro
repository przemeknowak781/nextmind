---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { formatPrice } from '../../lib/format';
import { getCatalog, plainDate, isRecruitmentOpen, seatsRange, BUR_FETCHED_AT } from '../../lib/bur';

// Katalog budujemy z naszego profilu w Bazie Usług Rozwojowych, a nie z ręcznie
// utrzymywanych plików. Dzięki temu tytuły, ceny, liczba miejsc i terminy na
// stronie są dokładnie tym, na co można się zapisać.
const catalog = getCatalog();
const seats = seatsRange();

const fetchedLabel = BUR_FETCHED_AT
  ? new Date(BUR_FETCHED_AT).toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', year: 'numeric' })
  : null;

function shortDate(iso: string | null) {
  return (
    plainDate(iso)?.toLocaleDateString('pl-PL', {
      day: '2-digit',
      month: '2-digit',
      timeZone: 'UTC',
    }) ?? ''
  );
}
---

<BaseLayout
  title="Szkolenia AI i Microsoft 365 — pełny katalog z terminami"
  description="Wszystkie nasze szkolenia dostępne w Bazie Usług Rozwojowych: tematy, ceny, liczba miejsc i najbliższe terminy. Każde można rozliczyć z dofinansowania."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Szkolenia' },
    ]} />
  </div>

  <Section padding="default">
    <div class="max-w-3xl">
      <div class="eyebrow">Katalog</div>
      <h1 class="mt-5 text-5xl md:text-6xl lg:text-[4.75rem] leading-[0.98] tracking-tight">
        Nasze <span class="display-italic">szkolenia</span>.
      </h1>
      <p class="lead mt-6 text-[var(--color-ink-3)]">
        {catalog.length} tematów w ofercie, wszystkie wpisane do Bazy Usług Rozwojowych —
        od jednodniowych warsztatów po programy stugodzinne.
        {seats && ` Wielkość grup: od ${seats.min} do ${seats.max} osób, zależnie od szkolenia.`}
      </p>
    </div>
  </Section>

  <Section surface="paper-soft" padding="default">
    <div class="cat">
      {catalog.map((o) => {
        const next = o.terms.find((t) => isRecruitmentOpen(t)) ?? o.terms[0];
        return (
          <article class="offer">
            <div class="offer-main">
              <h2 class="offer-title">
                <a href={`/szkolenia/${o.slug}/`}>{o.title}</a>
              </h2>
              <div class="offer-meta">
                {o.days > 0 && <span>{o.days === 1 ? '1 dzień' : `${o.days} dni`}</span>}
                {o.hours && <span>{o.hours} h</span>}
                {o.seatsMin && o.seatsMax && <span>{o.seatsMin}–{o.seatsMax} osób</span>}
                <span>{o.terms.length} {o.terms.length === 1 ? 'termin' : 'terminy'}</span>
              </div>
              {next?.startDate && (
                <p class="offer-next">
                  Najbliższy termin: <strong>{shortDate(next.startDate)}</strong>
                  {!isRecruitmentOpen(next) && ' — rekrutacja zamknięta'}
                </p>
              )}
            </div>
            <div class="offer-side">
              {o.priceNet !== null && (
                <div class="offer-price">
                  <span class="offer-price-val">{formatPrice(o.priceNet)}</span>
                  <span class="offer-price-lbl">netto / osoba</span>
                </div>
              )}
              <a href={`/szkolenia/${o.slug}/`} class="btn btn-secondary btn-sm">Program i terminy</a>
            </div>
          </article>
        );
      })}
    </div>
  </Section>

  <Section padding="tight">
    <div class="max-w-3xl">
      <h2 class="text-2xl font-display tracking-tight">Chcesz rozliczyć szkolenie z dofinansowania?</h2>
      <p class="mt-3 text-[var(--color-ink-3)]">
        Każde szkolenie z tego katalogu jest w Bazie Usług Rozwojowych, więc kwalifikuje się do
        rozliczenia z KFS albo z programu regionalnego. Sprawdź, gdzie złożyć wniosek — a formalności
        przejdziemy razem.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/dofinansowanie/kalkulator/" class="btn btn-primary">Sprawdź swoją ścieżkę</a>
        <a href="/pomoc-z-wnioskiem/" class="btn btn-ghost">Pomożemy z wnioskiem</a>
      </div>
      <p class="mt-6 text-xs text-[var(--color-ink-4)]">
        Dane z profilu dostawcy w BUR{fetchedLabel && `, pobrane ${fetchedLabel}`}.
        Wiążąca jest karta usługi w BUR.
      </p>
    </div>
  </Section>
</BaseLayout>

<style>
  .cat { display: grid; gap: 0.65rem; }
  .offer {
    display: grid;
    gap: 1rem;
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    padding: 1.35rem 1.5rem;
    transition: border-color 0.18s ease;
  }
  .offer:hover { border-color: var(--color-rule-strong); }
  @media (min-width: 860px) {
    .offer { grid-template-columns: 1fr auto; align-items: center; gap: 2rem; }
  }
  .offer-title {
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
  }
  .offer-title a { color: inherit; text-decoration: none; }
  .offer-title a:hover { color: var(--color-accent-deep); }
  .offer-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--color-ink-4);
  }
  .offer-meta span { white-space: nowrap; }
  .offer-next { margin-top: 0.5rem; font-size: 0.82rem; color: var(--color-ink-3); }
  .offer-next strong { color: var(--color-ink); font-weight: 500; }
  .offer-side {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  @media (min-width: 860px) {
    .offer-side { flex-direction: column; align-items: flex-end; gap: 0.6rem; }
  }
  .offer-price { text-align: right; white-space: nowrap; }
  .offer-price-val {
    display: block;
    font-family: var(--font-display);
    font-size: 1.35rem;
    color: var(--color-ink);
  }
  .offer-price-lbl {
    display: block;
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-4);
  }
</style>
