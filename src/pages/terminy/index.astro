---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { formatDayNumber, formatMonthShort, formatWeekday } from '../../lib/format';

const editions = await getCollection('editions');
const courses = await getCollection('courses');
const courseMap = new Map(courses.map((c) => [c.data.slug, c]));

const sorted = [...editions].sort((a, b) => +a.data.date - +b.data.date);
const upcoming = sorted.filter((e) => e.data.date >= new Date());

// Group by month
const byMonth = new Map<string, typeof upcoming>();
for (const ed of upcoming) {
  const key = `${ed.data.date.getFullYear()}-${String(ed.data.date.getMonth() + 1).padStart(2, '0')}`;
  if (!byMonth.has(key)) byMonth.set(key, []);
  byMonth.get(key)!.push(ed);
}
---

<BaseLayout
  title="Wszystkie terminy szkoleń AI | Najbliższe edycje Basic i Level 2"
  description="Pełny kalendarz najbliższych edycji szkoleń Next Mind Academy. Zobacz daty, dostępność miejsc i zapisz się przez BUR."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Terminy' },
    ]} />
  </div>

  <Section padding="default">
    <div class="grid lg:grid-cols-12 gap-12 items-end mb-16">
      <div class="lg:col-span-8">
        <div class="eyebrow">Kalendarz edycji 2026</div>
        <h1 class="mt-5 text-5xl md:text-6xl lg:text-[5.5rem] leading-[0.96] tracking-tight">
          Najbliższe <span class="display-italic">terminy</span>.
        </h1>
        <p class="lead mt-6 text-[var(--color-ink-3)] max-w-2xl">
          Wszystkie szkolenia są <strong class="text-[var(--color-ink)] font-medium">live online</strong>, w godzinach 9:00–16:00, w&nbsp;czwartki i&nbsp;wtorki.
          Każda edycja to maksymalnie 8–10 osób.
        </p>
      </div>
      <div class="lg:col-span-4 text-sm text-[var(--color-ink-3)] space-y-1.5">
        <div class="flex items-center gap-3">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--color-positive)]"></span>
          <span>Otwarty zapis</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--color-warn)]"></span>
          <span>Ostatnie miejsca</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="inline-block w-2.5 h-2.5 rounded-full bg-[var(--color-rule-strong)]"></span>
          <span>Planowany — zapis wkrótce</span>
        </div>
      </div>
    </div>

    <div class="space-y-12">
      {[...byMonth.entries()].map(([_key, eds]) => {
        const date = new Date(eds[0].data.date);
        return (
          <div class="month-block">
            <h2 class="month-title">
              <span class="font-mono text-xs uppercase tracking-[0.18em] text-[var(--color-ink-4)]">{date.getFullYear()}</span>
              <span class="display-italic text-5xl text-[var(--color-ink)] mx-3">/</span>
              <span class="font-display text-5xl tracking-tight">{formatMonthShort(date)}</span>
            </h2>

            <div class="space-y-3 mt-6">
              {eds.map((ed) => {
                const course = courseMap.get(ed.data.courseSlug);
                if (!course) return null;
                const ratio = ed.data.seatsAvailable / ed.data.seatsTotal;
                const status = ed.data.status === 'planned' ? 'rule-strong' :
                              ratio > 0.5 ? 'positive' :
                              ratio > 0.25 ? 'warn' : 'danger';
                return (
                  <a href={`/terminy/${ed.id.replace('.json', '')}/`} class="edition-row">
                    <div class="edition-date">
                      <span class="edition-day">{formatDayNumber(ed.data.date)}</span>
                      <span class="edition-weekday">{formatWeekday(ed.data.date).slice(0, 3)}</span>
                    </div>
                    <div class="edition-main">
                      <div class="text-[0.7rem] uppercase tracking-[0.14em] text-[var(--color-ink-4)] font-mono mb-1">
                        {course.data.eyebrow.split('•')[2]?.trim() ?? course.data.levelLabel}
                      </div>
                      <h3 class="edition-title">{course.data.title.split(':')[0].trim()}</h3>
                      <div class="text-sm text-[var(--color-ink-3)] mt-1">
                        {ed.data.startTime}–{ed.data.endTime} · {ed.data.platform}
                      </div>
                    </div>
                    <div class="edition-seats">
                      <span class={`edition-dot edition-dot-${status}`}></span>
                      <span class="font-mono tabular-nums">
                        <strong class="text-[var(--color-ink)]">{ed.data.seatsAvailable}</strong>
                        <span class="text-[var(--color-ink-4)]">/{ed.data.seatsTotal}</span>
                      </span>
                      <span class="text-xs text-[var(--color-ink-4)] block">miejsc</span>
                    </div>
                    <div class="edition-arrow">
                      <svg class="w-4 h-4" viewBox="0 0 16 16" fill="none">
                        <path d="M3 8H13M13 8L8 3M13 8L8 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        );
      })}
    </div>

    {upcoming.length === 0 && (
      <div class="text-center py-20">
        <p class="text-[var(--color-ink-3)]">Najbliższe terminy zostaną opublikowane wkrótce.</p>
        <a href="/kontakt/" class="mt-6 btn btn-primary inline-flex">Zostaw kontakt</a>
      </div>
    )}
  </Section>
</BaseLayout>

<style>
  .month-block { border-top: 1px solid var(--color-rule); padding-top: 2rem; }
  .month-title { display: flex; align-items: baseline; }

  .edition-row {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    gap: 1.5rem;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    text-decoration: none;
    transition: all 0.2s ease;
  }
  .edition-row:hover {
    border-color: var(--color-ink);
    transform: translateX(2px);
  }
  .edition-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 4rem;
    border-right: 1px dashed var(--color-rule);
    padding-right: 1.5rem;
  }
  .edition-day {
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: var(--color-ink);
  }
  .edition-weekday {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    uppercase: true;
    text-transform: uppercase;
    color: var(--color-ink-4);
    letter-spacing: 0.14em;
    margin-top: 0.4rem;
  }
  .edition-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.1;
    color: var(--color-ink);
    letter-spacing: -0.015em;
  }
  .edition-seats {
    text-align: right;
    font-size: 0.85rem;
  }
  .edition-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    margin-right: 0.4rem;
  }
  .edition-dot-positive { background: var(--color-positive); }
  .edition-dot-warn { background: var(--color-warn); }
  .edition-dot-danger { background: var(--color-danger); }
  .edition-dot-rule-strong { background: var(--color-rule-strong); }

  .edition-arrow {
    color: var(--color-ink-3);
    transition: transform 0.2s ease;
  }
  .edition-row:hover .edition-arrow {
    color: var(--color-accent);
    transform: translateX(2px);
  }

  @media (max-width: 768px) {
    .edition-row {
      grid-template-columns: auto 1fr;
      grid-template-areas:
        "date main"
        "date seats";
      gap: 0.5rem 1rem;
    }
    .edition-date { grid-area: date; border-right: none; padding-right: 0; }
    .edition-main { grid-area: main; }
    .edition-seats { grid-area: seats; text-align: left; }
    .edition-arrow { display: none; }
  }
</style>
