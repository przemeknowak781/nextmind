---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { formatPrice } from '../../lib/format';
import {
  getUpcomingServices,
  groupByMonth,
  isRecruitmentOpen,
  countDays,
  dayHours,
  BUR_FETCHED_AT,
  plainDate,
} from '../../lib/bur';

// Terminy pochodzą wprost z naszego profilu w Bazie Usług Rozwojowych —
// pobiera je scripts/fetch-bur.mjs przed buildem. Dzięki temu kalendarz na
// stronie nie rozjeżdża się z tym, na co faktycznie można się zapisać.
const upcoming = getUpcomingServices();
const months = groupByMonth(upcoming);

const fetchedLabel = BUR_FETCHED_AT
  ? new Date(BUR_FETCHED_AT).toLocaleDateString('pl-PL', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
    })
  : null;

function dateRange(s: { startDate: string | null; endDate: string | null }) {
  if (!s.startDate) return '';
  const f = (d: string) =>
    plainDate(d)!.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit', timeZone: 'UTC' });
  const start = f(s.startDate);
  if (!s.endDate || s.endDate.slice(0, 10) === s.startDate.slice(0, 10)) return start;
  return `${start} – ${f(s.endDate)}`;
}

function dayNum(d: string | null) {
  return plainDate(d)?.toLocaleDateString('pl-PL', { day: '2-digit', timeZone: 'UTC' }) ?? '—';
}
function weekday(d: string | null) {
  return plainDate(d)?.toLocaleDateString('pl-PL', { weekday: 'short', timeZone: 'UTC' }) ?? '';
}
---

<BaseLayout
  title="Terminy szkoleń AI — kalendarz najbliższych edycji"
  description="Kalendarz szkoleń Next Mind Academy prosto z Bazy Usług Rozwojowych: daty, ceny, liczba miejsc i bezpośredni zapis przez BUR."
>
  <div class="container-edge pt-8">
    <Breadcrumbs items={[
      { name: 'Strona główna', url: '/' },
      { name: 'Terminy' },
    ]} />
  </div>

  <Section padding="default">
    <div class="max-w-3xl">
      <div class="eyebrow">Kalendarz</div>
      <h1 class="mt-5 page-h1">
        Najbliższe <span class="display-italic">terminy</span>.
      </h1>
      {upcoming.length > 0 ? (
        <p class="lead mt-6 text-[var(--color-ink-3)]">
          {upcoming.length} zaplanowanych szkoleń. Wszystkie są wpisane do Bazy Usług Rozwojowych,
          więc każde możesz rozliczyć z dofinansowania — zapisu dokonujesz bezpośrednio w BUR.
        </p>
      ) : (
        <p class="lead mt-6 text-[var(--color-ink-3)]">
          Ustalamy terminy kolejnych edycji. Napisz, a zarezerwujemy dla Ciebie miejsce.
        </p>
      )}
    </div>
  </Section>

  {upcoming.length === 0 && (
    <Section padding="tight">
      <a href="/kontakt/" class="btn btn-primary btn-lg">Zostaw kontakt</a>
    </Section>
  )}

  {months.map((month) => (
    <Section surface="paper-soft" padding="tight">
      <h2 class="month-head">{month.label}</h2>
      <ul class="terms">
        {month.services.map((s) => {
          const hours = dayHours(s);
          const days = countDays(s);
          const open = isRecruitmentOpen(s);
          return (
            <li class="term">
              <div class="term-date">
                <span class="term-day">{dayNum(s.startDate)}</span>
                <span class="term-wd">{weekday(s.startDate)}</span>
              </div>

              <div class="term-body">
                <h3 class="term-title">{s.title}</h3>
                <div class="term-meta">
                  <span>{dateRange(s)}</span>
                  {hours && <span>{hours.from}–{hours.to}</span>}
                  {days > 1 && <span>{days} dni</span>}
                  {s.hoursTotal && <span>{s.hoursTotal} h</span>}
                  {s.seatsMax && <span>do {s.seatsMax} osób</span>}
                </div>
              </div>

              <div class="term-side">
                {s.priceNetPerParticipant !== null && (
                  <div class="term-price">
                    <span class="term-price-val">{formatPrice(s.priceNetPerParticipant)}</span>
                    <span class="term-price-lbl">netto / osoba</span>
                  </div>
                )}
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener"
                  class={`btn btn-sm ${open ? 'btn-primary' : 'btn-ghost'}`}
                >
                  {open ? 'Zapisz się przez BUR' : 'Zobacz w BUR'}
                </a>
                {!open && <span class="term-closed">Rekrutacja zamknięta</span>}
              </div>
            </li>
          );
        })}
      </ul>
    </Section>
  ))}

  <Section padding="tight">
    <p class="text-sm text-[var(--color-ink-4)] max-w-3xl">
      Dane pochodzą z naszego profilu dostawcy w Bazie Usług Rozwojowych
      {fetchedLabel && <> i zostały pobrane {fetchedLabel}</>}. Wiążąca jest karta usługi w BUR —
      to tam sprawdzisz aktualną dostępność miejsc i tam dokonujesz zapisu. Jeśli chcesz rozliczyć
      szkolenie z dofinansowania, najpierw
      <a href="/dofinansowanie/kalkulator/" class="src"> sprawdź, gdzie złożyć wniosek</a>.
    </p>
  </Section>
</BaseLayout>

<style>
  .month-head {
    font-family: var(--font-display);
    font-size: 1.5rem;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    text-transform: capitalize;
    margin-bottom: 1.25rem;
  }
  .terms { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .term {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    align-items: start;
    background: var(--color-card-raised);
    border: 1px solid var(--color-rule);
    border-radius: 8px;
    padding: 1.1rem 1.25rem;
  }
  @media (min-width: 900px) {
    .term { grid-template-columns: 3.5rem 1fr auto; gap: 1.5rem; align-items: center; }
  }
  .term-date { text-align: center; }
  .term-day {
    display: block;
    font-family: var(--font-display);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-ink);
  }
  .term-wd {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-4);
    margin-top: 0.15rem;
  }
  .term-title {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.35;
  }
  .term-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 0.9rem;
    margin-top: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-ink-4);
  }
  .term-meta span { white-space: nowrap; }
  .term-side {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }
  @media (min-width: 900px) {
    .term-side {
      grid-column: auto;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.5rem;
      margin-top: 0;
    }
  }
  .term-price { text-align: right; white-space: nowrap; }
  .term-price-val {
    display: block;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
    font-size: 0.95rem;
    color: var(--color-ink);
  }
  .term-price-lbl {
    display: block;
    font-size: 0.66rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-ink-4);
  }
  .term-closed { font-size: 0.7rem; color: var(--color-ink-4); }
  .src { color: var(--color-accent-deep); text-decoration: underline; text-underline-offset: 3px; }
</style>
