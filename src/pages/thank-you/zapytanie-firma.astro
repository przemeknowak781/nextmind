---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Dziękujemy za zapytanie | Next Mind Academy"
  description="Otrzymaliśmy Twoje zapytanie. Odpowiemy w 24 godziny robocze."
  noindex={true}
>
  <section class="container-edge py-24 md:py-32">
    <div class="max-w-3xl">
      <span class="eyebrow !text-[var(--color-accent)]">Otrzymaliśmy</span>
      <h1 class="mt-5 page-h1">
        Odpowiemy w <span class="display-italic">24 godziny</span>.
      </h1>
      <p class="lead mt-8 text-[var(--color-ink-3)] max-w-2xl">
        Twoje zapytanie trafiło do trenera i&nbsp;zespołu operacyjnego. Pierwszy etap — bezpłatna konsultacja 45 min.
        Wybierzemy razem termin, omówimy potrzeby zespołu, przygotujemy ofertę.
      </p>

      <div class="mt-12 grid sm:grid-cols-3 gap-4">
        <div class="bg-[var(--color-card-raised)] border border-[var(--color-rule)] rounded-md p-5">
          <span class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--color-ink-4)]">01</span>
          <h3 class="font-display text-xl tracking-tight mt-2">24h</h3>
          <p class="text-sm text-[var(--color-ink-3)] mt-1">Pierwsza odpowiedź mailem</p>
        </div>
        <div class="bg-[var(--color-card-raised)] border border-[var(--color-rule)] rounded-md p-5">
          <span class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--color-ink-4)]">02</span>
          <h3 class="font-display text-xl tracking-tight mt-2">Konsultacja 45min</h3>
          <p class="text-sm text-[var(--color-ink-3)] mt-1">Bezpłatna, online</p>
        </div>
        <div class="bg-[var(--color-card-raised)] border border-[var(--color-rule)] rounded-md p-5">
          <span class="font-mono text-xs uppercase tracking-[0.14em] text-[var(--color-ink-4)]">03</span>
          <h3 class="font-display text-xl tracking-tight mt-2">Oferta w 48h</h3>
          <p class="text-sm text-[var(--color-ink-3)] mt-1">Po konsultacji</p>
        </div>
      </div>

      <a href="/" class="mt-12 inline-flex items-center gap-2 ink-link">← Wróć na stronę główną</a>
    </div>
  </section>
</BaseLayout>
